---
import '../../styles/theme.css';
import { BaseLayout, Embed } from 'meno-astro/components';
import NavBanner from '../../components/NavBanner.astro';
import Footer from '../../components/Footer.astro';

const meta = {
  "title": "Motion The Agency Privacy Policy | Your Data & Rights",
  "description": "",
  "htmlAttributes": {
    "data-wf-page": "67600e73ac4d50ca22ed9a58",
    "data-wf-site": "66ebfb6ec8f20d5eda50eb34"
  },
  "ogTitle": "Motion The Agency Privacy Policy | Your Data & Rights",
  "noindex": true,
  "customCode": {
    "head": "<meta name=\"twitter:title\" content=\"Motion The Agency Privacy Policy | Your Data &amp; Rights\">",
    "bodyStart": "<script>document.body.className=\"body\";</script>"
  }
};
const __embed0 = `<style>
