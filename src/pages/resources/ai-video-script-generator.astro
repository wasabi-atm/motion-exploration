    "bodyEnd": "\n<script src=\"https://cdn.jsdelivr.net/gh/videsigns/webflow-tools@latest/multi-step.js\"> </script>\n  <!--  Scroll to form section on \"next\" or \"back\" button click  -->\n  <script>\n$(document).ready(function () {\n    function customScrollTop() {\n        // Get the top position of the form section\n        var FormTop = $('#SectionForm').offset().top;\n        // Smoothly scroll to the form section\n        $('html, body').animate({ scrollTop: FormTop }, 400);\n    }\n    // Attach the scrolling function to \"next\" and \"back\" buttons\n    $('[data-form=\"next-btn\"]').on('click', customScrollTop);\n    $('[data-form=\"back-btn\"]').on('click', customScrollTop);\n});\n</script>\n  <!--  Hide form progress bar after submission  -->\n  <script>\n$(document).ready(function () {\n    $('#StepForm').on('submit', function () {\n        // Hide the progress bar wrapper when the form is submitted\n        $('.form-progress-wrapper').hide();\n    });\n});\n</script>\n  <!--  Reload the page on \"Start Over\" button click  -->\n  <script>\n$(document).ready(function() {\n    $('.start-over-button').on('click', function() {\n        // Reload the page to reset all form fields and selections\n        location.reload();\n    });\n});\n</script>\n  <!--  Change text color when select is active  -->\n  <script>\n$(document).ready(function () {\n    $('.hide-select').on('change', function () {\n        console.log('Select value changed'); // Debugging log\n        // Find the closest parent element with the class \"field-drop\"\n        let $parent = $(this).closest('.field-drop');\n        // Find the title element inside the parent\n        let $title = $parent.find('.field-drop-title');\n        // Change text color based on whether an option is selected\n        if ($(this).val()) {\n            $title.css('color', 'white'); // Active state (text is visible)\n        } else {\n            $title.css('color', 'rgba(255, 255, 255, 0.2)'); // Inactive state (text is faded)\n        }\n    });\n});\n</script>\n  ",
