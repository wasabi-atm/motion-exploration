rvice\",\n      \"description\": \"On-demand design and animation subscription service for startups, SaaS, and tech businesses. Includes graphic design, 2D/3D animation, UI design, storyboard planning, and website development depending on plan.\",\n      \"url\": \"https://www.motiontheagency.com/pricing/design-subscription-services\",\n      \"provider\": { \"@id\": \"https://www.motiontheagency.com/#org\" },\n      \"serviceType\": \"Design as a Subscription\",\n      \"areaServed\": [\"US\", \"GB\", \"AU\"],\n      \"hasOfferCatalog\": {\n        \"@type\": \"OfferCatalog\",\n        \"name\": \"Design Subscription Plans\",\n        \"itemListElement\": [\n          {\n            \"@type\": \"Offer\",\n            \"name\": \"Basic\",\n            \"description\": \"Perfect for social content and marketing collateral. Includes graphic design, simple 2D animation, 2 expert designers, 30-40 hours logged design, unlimited revisions, and dedicated creative team.\",\n            \"price\": \"2920\",\n            \"priceCurrency\": \"GBP\",\n            \"url\": \"https://www.motiontheagency.com/pricing/design-subscription-services\",\n            \"priceSpecification\": {\n              \"@type\": \"UnitPriceSpecification\",\n              \"price\": \"2920\",\n              \"priceCurrency\": \"GBP\",\n              \"billingDuration\": {\n                \"@type\": \"QuantitativeValue\",\n                \"value\": 1,\n                \"unitCode\": \"MON\"\n              }\n            },\n            \"availability\": \"https://schema.org/InStock\"\n          },\n          {\n            \"@type\": \"Offer\",\n            \"name\": \"Premium\",\n            \"description\": \"Perfect for large events, training courses, and multiple website videos. Includes UI design, graphic design, storyboard planning, complex 2D + 3D animation, 3 expert designers, 80-110 hours logged design.\",\n            \"price\": \"4880\",\n            \"priceCurrency\": \"GBP\",\n         