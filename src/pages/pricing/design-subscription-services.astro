<script is:inline>
  $(document).ready(function () {
    const texts = [
      "Animator",
      "Video Editor",
      "Animator",
      "Graphic Designer",
      "UI/UX Designer",
      "Motion Designer"
    ];
    let index = 0;
    let charIndex = 0;
    const typingSpeed = 200;
    const deletingSpeed = 100;
    const delayBetweenTexts = 1500;
    const $rotator = $('#text-rotator');
    const typeText = () => {
      if (charIndex < texts[index].length) {
        $rotator.text($rotator.text() + texts[index][charIndex]);
        charIndex++;
        setTimeout(typeText, typingSpeed);
      } else {
        setTimeout(deleteText, delayBetweenTexts);
      }
    };
    const deleteText = () => {
      if (charIndex > 0) {
        $rotator.text($rotator.text().slice(0, -1));
        charIndex--;
        setTimeout(deleteText, deletingSpeed);
      } else {
        index = (index + 1) % texts.length;
        setTimeout(typeText, typingSpeed);
      }
    };
    typeText();
  });
</script>
