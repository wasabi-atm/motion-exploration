const __embed3 = `<style>
.motion-compare,
.motion-compare * {
  box-sizing: border-box;
}
/* =================================
   ROOT
================================= */
.motion-compare {
  --bg:#09061d;
  --bg-cell:#121032;
  --bg-deep:#0d0a26;
  --line:rgba(230,226,255,.22);
  --purple:
  linear-gradient(
    135deg,
    rgba(52,33,139,.95),
    rgba(38,16,102,.95)
  );
  width:100%;
  color:#f7f4ff;
  font-family:inherit;
}
/* =================================
   WRAPPER
================================= */
.motion-compare__wrap {
  width:100%;
  max-width:1280px;
  margin:auto;
  overflow:hidden;
  border:
  1px solid var(--line);
  border-radius:14px;
  background:#09061d;
}
/* =================================
   TABLE
================================= */
.motion-compare__table {
  width:100%;
  table-layout:fixed;
  border-collapse:collapse;
  background:#09061d;
}
.motion-compare__table col:first-child {
  width:28%;
}
.motion-compare__table col:nth-child(2),
.motion-compare__table col:nth-child(3),
.motion-compare__table col:nth-child(4){
  width:24%;
}
.motion-compare th,
.motion-compare td {
  padding:26px 28px;
  border-right:
  1px solid var(--line);
  border-bottom:
  1px solid var(--line);
  vertical-align:middle;
  text-align:left;
  overflow:hidden;
}
.motion-compare th:last-child,
.motion-compare td:last-child {
  border-right:0;
}
/* =================================
   HEADER
================================= */
.motion-compare thead th {
  height:118px;
  background:
  linear-gradient(
    180deg,
    rgba(28,22,80,.95),
    rgba(18,13,50,.95)
  );
}
.motion-compare .is-featured {
  background:
  radial-gradient(
    circle at 80% 10%,
    rgba(110,92,255,.22),
    transparent 48%
  ),
  var(--purple);
}
.motion-compare__plan-title {
  margin:0 0 8px;
  font-size:28px;
  line-height:1.15;
  font-weight:700;
}
.motion-compare__plan-desc {
  margin:0;
  color:
  rgba(247,244,255,.68);
  font-size:16px;
}
/* =================================
   SECTION HEADER
================================= */
.motion-compare__section-row th {
  padding:26px 28px;
  background:
  linear-gradient(
    90deg,
    rgba(29,11,75,.95),
    rgba(37,32,90,.95)
  );
  color:
  rgba(247,244,255,.68);
  font-size:16px;
  letter-spacing:.42em;
  text-transform:uppercase;
}
/* =================================
   BODY
================================= */
.motion-compare__feature {
  background:
  linear-gradient(
    180deg,
    var(--bg-cell),
    var(--bg-deep)
  );
  font-size:22px;
  line-height:1.25;
  font-weight:700;
}
.motion-compare__cell {
  background:#09061d;
  color:
  rgba(247,244,255,.82);
  font-size:16px;
  line-height:1.45;
}
.motion-compare__value {
  display:block;
  overflow-wrap:anywhere;
}
/* =================================
   PRICE
================================= */
.motion-compare__price {
  display:block;
  font-size:30px;
  line-height:1.15;
  letter-spacing:-.04em;
  overflow-wrap:anywhere;
}
.motion-compare strong {
  color:#fff;
}
/* =================================
   PILLS
================================= */
.motion-compare__pill {
  display:inline-flex;
  align-items:center;
  gap:8px;
  max-width:100%;
  padding:
  9px 16px;
  border-radius:999px;
  font-size:15px;
  line-height:1.3;
  white-space:normal;
}
.motion-compare__pill-icon {
  flex:none;
}
.motion-compare__pill-text {
  overflow-wrap:anywhere;
}
.motion-compare__pill--green {
  background:
  linear-gradient(
    135deg,
    rgba(22,125,88,.9),
    rgba(45,127,117,.9)
  );
}
.motion-compare__pill--gold {
  background:
  linear-gradient(
    135deg,
    rgba(201,157,50,.9),
    rgba(169,134,67,.9)
  );
}
.motion-compare__pill--grey {
  background:
  rgba(52,49,67,.9);
}
/* =================================
   CTA
================================= */
.motion-compare__button {
  display:flex;
  align-items:center;
  justify-content:center;
  width:100%;
  min-height:50px;
  border-radius:999px;
  color:white;
  text-decoration:none;
  font-weight:700;
}
.motion-compare__button--primary {
  background:
  linear-gradient(
    90deg,
    #ff0b8f,
    #ff2caf
  );
}
.motion-compare__button--secondary {
  background:
  rgba(255,255,255,.05);
  border:
  1px solid rgba(255,255,255,.15);
}
/* =================================
   TABLET
================================= */
@media(max-width:991px){
.motion-compare th,
.motion-compare td {
  padding:22px 20px;
}
.motion-compare__feature {
  font-size:19px;
