                <div class="card-content-padding-40">
                  <div class="for-whom-strip">
                    <div id="w-node-_432297b8-a6d8-c2ee-4f4a-b76734f57a6e-9f33d489" class="w-layout-hflex flex-h _16 _w-hug align-center-middle">
                      <div class="w-layout-hflex flex-h _8">
                        <h3 class="heading-48">80%</h3>
                      </div>
