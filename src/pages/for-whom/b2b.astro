        <div id="banner-trigger" class="nav_banner-trigger"></div><img src="/images/logoStripMobileB2B1.avif" loading="lazy" sizes="100vw" srcset="/images/logoStripMobileB2B1-p-500.avif 500w, /images/logoStripMobileB2B1-p-800.avif 800w, /images/logoStripMobileB2B1-p-1080.avif 1080w, /images/logoStripMobileB2B1.avif 1436w" alt="" class="absolute-img-for-whom mobile"><img src="/images/logoStripDesktopB2B1.avif" loading="lazy" sizes="100vw" srcset="/images/logoStripDesktopB2B1-p-500.avif 500w, /images/logoStripDesktopB2B1-p-800.avif 800w, /images/logoStripDesktopB2B1-p-1080.avif 1080w, /images/logoStripDesktopB2B1-p-1600.avif 1600w, /images/logoStripDesktopB2B1-p-2000.avif 2000w, /images/logoStripDesktopB2B1.avif 2560w" alt="" class="absolute-img-for-whom mobile-hide">
