                <div class="card-content-padding-40">
                  <div class="for-whom-strip">
                    <div id="w-node-_1fa3a2c6-0c4d-0c21-5294-180384bbfe33-0c5ae905" class="w-layout-hflex flex-h _16 _w-hug align-center-middle">
                      <div class="w-layout-hflex flex-h _8">
