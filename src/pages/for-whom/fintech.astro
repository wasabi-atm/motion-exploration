    "head": "\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@graph\": [\n    {\n      \"@type\": \"WebPage\",\n      \"@id\": \"https://www.motiontheagency.com/for-whom/b2b\",\n      \"url\": \"https://www.motiontheagency.com/for-whom/b2b\",\n      \"name\": \"B2B Video Production Agency | Motion Graphics for Business Marketing\",\n      \"description\": \"Transform your B2B marketing with powerful video storytelling. Motion The Agency creates high-quality explainer videos, product demos, and corporate videos that drive engagement, build trust, and accelerate growth for business audiences.\",\n      \"inLanguage\": \"en-US\",\n      \"isPartOf\": { \"@id\": \"https://www.motiontheagency.com/#website\" },\n      \"breadcrumb\": { \"@id\": \"https://www.motiontheagency.com/for-whom/b2b#breadcrumb\" },\n      \"primaryImageOfPage\": {\n        \"@type\": \"ImageObject\",\n        \"url\": \"https://cdn.motiontheagency.com/b2b/cover.jpg\",\n        \"width\": 1200,\n        \"height\": 630\n      }\n    },\n    {\n      \"@type\": \"BreadcrumbList\",\n      \"@id\": \"https://www.motiontheagency.com/for-whom/b2b#breadcrumb\",\n      \"itemListElement\": [\n        { \"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://www.motiontheagency.com/\" },\n        { \"@type\": \"ListItem\", \"position\": 2, \"name\": \"For Whom\", \"item\": \"https://www.motiontheagency.com/for-whom\" },\n        { \"@type\": \"ListItem\", \"position\": 3, \"name\": \"B2B\", \"item\": \"https://www.motiontheagency.com/for-whom/b2b\" }\n      ]\n    },\n    {\n      \"@type\": \"Organization\",\n      \"@id\": \"https://www.motiontheagency.com/#organization\",\n      \"name\": \"Motion The Agency\",\n      \"url\": \"https://www.motiontheagency.com/\",\n      \"logo\": {\n        \"@type\": \"ImageObject\",\n        \"url\": \"https://cdn.prod.website-files.com/66ebfb6ec8f20d5eda50eb34/66ebfe7ccb344ea14e764cd7_Link%20%E2%86%92%20cropped-motion-logo-png-04-1-1024x293.png.avif\",\n        \"width\": 1024,\n        \"height\": 293\n      },\n      \"image\": \"https://cdn.motiontheagency.com/og-image-motion.jpg\",\n      \"description\": \"Full-service motion graphics and video production agency based in London, UK. We help B2B brands communicate their value through dynamic visual storytelling.\",\n      \"email\": \"hello@motiontheagency.com\",\n      \"telephone\": \"+44 203 984 7787\",\n      \"address\": {\n        \"@type\": \"PostalAddress\",\n        \"streetAddress\": \"42-44 Bishopsgate\",\n        \"addressLocality\": \"London\",\n        \"postalCode\": \"EC2N 4AH\",\n        \"addressCountry\": \"GB\"\n      },\n      \"sameAs\": [\n        \"https://www.linkedin.com/company/motion-the-agency\",\n        \"https://www.youtube.com/@motiontheagency\",\n        \"https://clutch.co/profile/motion-agency-0\"\n      ],\n      \"aggregateRating\": {\n        \"@type\": \"AggregateRating\",\n        \"ratingValue\": \"5\",\n        \"reviewCount\": \"25\",\n        \"bestRating\": \"5\"\n      }\n    },\n    {\n      \"@type\": \"Service\",\n      \"@id\": \"https://www.motiontheagency.com/for-whom/b2b#service\",\n      \"name\": \"B2B Video Production\",\n      \"serviceType\": \"Video Production & Animation\",\n      \"category\": \"B2B Marketing Videos\",\n      \"provider\": { \"@id\": \"https://www.motiontheagency.com/#organization\" },\n      \"areaServed\": { \"@type\": \"Place\", \"name\": \"Worldwide\" },\n      \"audience\": {\n        \"@type\": \"Audience\",\n        \"audienceType\": \"B2B Companies, SaaS Businesses, Enterprise Brands, Tech Firms, Startups\"\n      },\n      \"description\": \"Professional B2B video production services including explainer videos, product demos, case study videos, and corporate video content designed to drive engagement and conversions.\",\n      \"hasOfferCatalog\": {\n        \"@type\": \"OfferCatalog\",\n        \"name\": \"B2B Video Services\",\n        \"itemListElement\": [\n          { \"@type\": \"Offer\", \"itemOffered\": { \"@type\": \"Service\", \"name\": \"Free Video Sample\", \"description\": \"Get a customized B2B video sample within 3 working days after consultation.\" }, \"price\": \"0\", \"priceCurrency\": \"GBP\" },\n          { \"@type\": \"Offer\", \"itemOffered\": { \"@type\": \"Service\", \"name\": \"Explainer Videos\", \"description\": \"Simplify complex concepts and drive awareness through animated explainers.\" } },\n          { \"@type\": \"Offer\", \"itemOffered\": { \"@type\": \"Service\", \"name\": \"Product Demo Videos\", \"description\": \"Showcase your B2B product capabilities in a visually compelling way.\" } },\n          { \"@type\": \"Offer\", \"itemOffered\": { \"@type\": \"Service\", \"name\": \"Corporate Videos\", \"description\": \"Build brand authority and communicate your company vision effectively.\" } },\n          { \"@type\": \"Offer\", \"itemOffered\": { \"@type\": \"Service\", \"name\": \"Case Study Videos\", \"description\": \"Turn client success stories into persuasive, results-driven narratives.\" } },\n          { \"@type\": \"Offer\", \"itemOffered\": { \"@type\": \"Service\", \"name\": \"Training Videos\", \"description\": \"Enhance internal communication and employee onboarding with clear visuals.\" } }\n        ]\n      }\n    },\n    {\n      \"@type\": \"FAQPage\",\n      \"@id\": \"https://www.motiontheagency.com/for-whom/b2b#faq\",\n      \"mainEntity\": [\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What is B2B video production?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"B2B video production involves creating video content specifically designed for business-to-business marketing. This type of video aims to convey complex ideas, showcase products, and build relationships with potential clients through compelling visual storytelling.\" }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"Why is video important for B2B marketing?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"In the digital age, video is a crucial communication tool that simplifies complex concepts, showcases product value, builds trust, enhances engagement, and ultimately drives conversion rates. It helps companies stand out in a competitive marketplace.\" }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What types of B2B videos do you produce?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"We create a range of B2B video content, including Explainer videos, Product demos, Case study videos, Corporate videos, and Training videos.\" }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"How does your production process work?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Our process includes understanding your unique products and services, conceptualizing engaging narratives, producing high-quality visual content, and refining the final product based on your feedback to ensure it aligns with your goals.\" }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"Do you offer free samples?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Yes! We offer a free sample service that allows you to see our capabilities and style before making a commitment. You can expect this sample within 3 working days after our initial consultation.\" }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"How is your pricing structured?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Motion provides transparent pricing with no hidden costs. We offer upfront quotes and flexible options, including subscription models or project-based pricing, tailored to your budget and needs.\" }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What is your typical timeline?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"The timeline varies depending on the video's complexity and your specific requirements. We will provide a detailed timeline during our initial discussion, and we keep you updated throughout the production process.\" }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"How do I get started?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"To get started, simply schedule a call with us to discuss your video needs. Following the conversation, we will deliver a customized sample within 3 working days.\" }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"Can I use the video across multiple platforms?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Absolutely! We deliver your final video in the optimal formats for various marketing channels, allowing you to effectively share it on your website, social media platforms, and other digital channels.\" }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What if I need revisions?\",\n          \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"We strive for your complete satisfaction. If you need to make changes after the video is delivered, our team will work closely with you to accommodate your requests and ensure the final product meets your expectations.\" }\n        }\n      ]\n    },\n    {\n      \"@type\": \"VideoObject\",\n      \"name\": \"Wranx | 2D Animated Explainer Video\",\n      \"description\": \"2D animated explainer video created for Wranx to showcase their SaaS training platform.\",\n      \"thumbnailUrl\": \"https://i.ytimg.com/vi/5y5vTnTL0a4/maxresdefault.jpg\",\n      \"uploadDate\": \"2023-12-05T09:00:00+00:00\",\n      \"contentUrl\": \"https://www.youtube.com/watch?v=5y5vTnTL0a4\",\n      \"embedUrl\": \"https://www.youtube.com/embed/5y5vTnTL0a4\",\n      \"interactionStatistic\": { \"@type\": \"InteractionCounter\", \"interactionType\": \"WatchAction\", \"userInteractionCount\": 320 },\n      \"publisher\": { \"@id\": \"https://www.motiontheagency.com/#organization\" }\n    },\n    {\n      \"@type\": \"VideoObject\",\n      \"name\": \"Sopra Steria | 2D Animated Company Reel\",\n      \"description\": \"2D animated company reel for Sopra Steria showcasing their corporate identity.\",\n      \"thumbnailUrl\": \"https://i.ytimg.com/vi/mFTD1t-WIlw/maxresdefault.jpg\",\n      \"uploadDate\": \"2024-08-06T09:00:00+00:00\",\n      \"contentUrl\": \"https://www.youtube.com/watch?v=mFTD1t-WIlw\",\n      \"embedUrl\": \"https://www.youtube.com/embed/mFTD1t-WIlw\",\n      \"interactionStatistic\": { \"@type\": \"InteractionCounter\", \"interactionType\": \"WatchAction\", \"userInteractionCount\": 269 },\n      \"publisher\": { \"@id\": \"https://www.motiontheagency.com/#organization\" }\n    },\n    {\n      \"@type\": \"VideoObject\",\n      \"name\": \"Linkstub | Product Launch Explainer\",\n      \"description\": \"2D animated motion graphic explainer video for Linkstub product launch campaign.\",\n      \"thumbnailUrl\": \"https://i.ytimg.com/vi/7Liobx4PsYE/maxresdefault.jpg\",\n      \"uploadDate\": \"2023-08-18T09:00:00+00:00\",\n      \"contentUrl\": \"https://www.youtube.com/watch?v=7Liobx4PsYE\",\n      \"embedUrl\": \"https://www.youtube.com/embed/7Liobx4PsYE\",\n      \"interactionStatistic\": { \"@type\": \"InteractionCounter\", \"interactionType\": \"WatchAction\", \"userInteractionCount\": 351 },\n      \"publisher\": { \"@id\": \"https://www.motiontheagency.com/#organization\" }\n    },\n    {\n      \"@type\": \"VideoObject\",\n      \"name\": \"Future Fit | Mixed Media Explainer Video\",\n      \"description\": \"Narrative-driven mixed media explainer video for Future Fit combining real footage and animation.\",\n      \"thumbnailUrl\": \"https://i.ytimg.com/vi/PJW3vsj9lV0/maxresdefault.jpg\",\n      \"uploadDate\": \"2025-09-11T09:00:00+00:00\",\n      \"contentUrl\": \"https://www.youtube.com/watch?v=PJW3vsj9lV0\",\n      \"embedUrl\": \"https://www.youtube.com/embed/PJW3vsj9lV0\",\n      \"interactionStatistic\": { \"@type\": \"InteractionCounter\", \"interactionType\": \"WatchAction\", \"userInteractionCount\": 393 },\n      \"publisher\": { \"@id\": \"https://www.motiontheagency.com/#organization\" }\n    },\n    {\n      \"@type\": \"VideoObject\",\n      \"name\": \"BizBaby | 2D Animated SaaS Explainer Video\",\n      \"description\": \"2D animated explainer video created for BizBaby SaaS platform focusing on UI and storytelling.\",\n      \"thumbnailUrl\": \"https://i.ytimg.com/vi/FrmDeKkmCqU/maxresdefault.jpg\",\n      \"uploadDate\": \"2024-06-27T09:00:00+00:00\",\n      \"contentUrl\": \"https://www.youtube.com/watch?v=FrmDeKkmCqU\",\n      \"embedUrl\": \"https://www.youtube.com/embed/FrmDeKkmCqU\",\n      \"interactionStatistic\": { \"@type\": \"InteractionCounter\", \"interactionType\": \"WatchAction\", \"userInteractionCount\": 172 },\n      \"publisher\": { \"@id\": \"https://www.motiontheagency.com/#organization\" }\n    },\n    {\n      \"@type\": \"VideoObject\",\n      \"name\": \"ITN Holdings | PVX | 2D and 3D Animated Video\",\n      \"description\": \"2D and 3D animated video created for ITN Holdings to showcase their PVX solution for enterprise.\",\n      \"thumbnailUrl\": \"https://i.ytimg.com/vi/TpZBjSx6rBY/maxresdefault.jpg\",\n      \"uploadDate\": \"2024-07-31T09:00:00+00:00\",\n      \"contentUrl\": \"https://www.youtube.com/watch?v=TpZBjSx6rBY\",\n      \"embedUrl\": \"https://www.youtube.com/embed/TpZBjSx6rBY\",\n      \"interactionStatistic\": { \"@type\": \"InteractionCounter\", \"interactionType\": \"WatchAction\", \"userInteractionCount\": 48 },\n      \"publisher\": { \"@id\": \"https://www.motiontheagency.com/#organization\" }\n    }\n  ]\n}\n</script>\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"VideoObject\",\n  \"name\": \"Cornerstone | 2D Animated Product Demo\",\n  \"description\": \"Product demo video for Cornerstone showcasing B2B solutions with 2D animation.\",\n  \"thumbnailUrl\": \"https://i.ytimg.com/vi/mnwgMTfmbNc/maxresdefault.jpg\",\n  \"uploadDate\": \"2024-07-23T01:06:40-07:00\",\n  \"duration\": \"PT1M20S\",\n  \"embedUrl\": \"https://www.youtube.com/embed/mnwgMTfmbNc\",\n  \"contentUrl\": \"https://www.youtube.com/watch?v=mnwgMTfmbNc\",\n  \"publisher\": {\n    \"@type\": \"Organization\",\n    \"name\": \"Motion The Agency\",\n    \"logo\": {\n      \"@type\": \"ImageObject\",\n      \"url\": \"https://cdn.prod.website-files.com/66ebfb6ec8f20d5eda50eb34/6762c1dea24d4f98491f457f_Logo.png\"\n    }\n  }\n}\n</script>\n  <meta name=\"twitter:title\" content=\"Fintech\">\n<meta name=\"twitter:description\" content=\"B2B video production for deals decided by six to ten people, giving product, finance, IT and leadership a clear reason to say yes.\">\n<meta name=\"twitter:image\" content=\"https://cdn.prod.website-files.com/67601fee10470581a90722d7/67602bd27d29b464069f8f7a_Key%20Insight.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">",
