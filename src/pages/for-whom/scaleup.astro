                  </div>
                </nav>
              </div>
              <div data-delay="0" data-hover="false" data-w-id="237b7cfb-96e6-8769-f68d-ac2269a2d687" class="dropdown-faq w-dropdown [display:inline-block] [position:relative] [text-align:left] [margin-left:auto] [margin-right:auto] [z-index:900] [cursor:pointer] [background-image:linear-gradient(75deg,_#0a0814b3,_#140d24b3)] [border:1px_solid_#ffffff1a] [border-radius:25px] [width:100%] [padding-left:20px] [padding-right:20px] max-sm:[z-index:1]">
