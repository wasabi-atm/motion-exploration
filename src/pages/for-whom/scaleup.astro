                  <div data-is-ix2-target="1" class="ic-plus-faq [width:20px] [min-width:20px] [height:20px] [min-height:20px] max-sm:[min-width:2rem]" data-w-id="6dd9978b-777b-d69a-c86a-2452fc7e14ab" data-animation-type="lottie" data-src="https://uploads-ssl.webflow.com/62581cacf7654a9838775673/62581cacf7654a49f0775692_plus.json" data-loop="0" data-direction="1" data-autoplay="0" data-renderer="svg" data-default-duration="0.5" data-duration="0" data-loading="eager"></div>
