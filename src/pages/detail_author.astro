  height: calc(100% + 12px);
}
.card_glow_background._2 {
	left : calc(-100% - 24px); 
}
.card_glow_background._3 {
	top : calc(-100% - 24px);
}
.card_glow_background._4 {
	left : calc(-100% - 24px);
  top : calc(-100% - 24px);
}
</style>
