	clear: both;
	content: "";
	display: block
}
.glowing-wrapper-animations {
	pointer-events: none;
}
.glowing-wrapper-animations * {
	height: 100%;
	left: 0;
	position: absolute;
	top: 0;
	width: 100%
}
.glowing-wrapper-borders,
.glowing-wrapper-glow,
