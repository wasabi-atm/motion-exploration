n      \"author\": {\n        \"@id\": \"https://www.motiontheagency.com/#organization\"\n      },\n      \"breadcrumb\": {\n        \"@id\": \"https://www.motiontheagency.com/customer-stories/primer#breadcrumb\"\n      },\n      \"datePublished\": \"2026-06-29T00:00:00+00:00\",\n      \"description\": \"Primer, a VC-backed payments platform, returned to Motion across 3 projects. See how we turned their product launches into animated videos that convert.\",\n      \"headline\": \"How We Made Primer's Product Launch Videos\",\n      \"inLanguage\": \"en\",\n      \"isPartOf\": {\n        \"@id\": \"https://www.motiontheagency.com/#website\"\n      },\n      \"mainEntityOfPage\": {\n        \"@id\": \"https://www.motiontheagency.com/customer-stories/primer\",\n        \"@type\": \"WebPage\"\n      },\n      \"publisher\": {\n        \"@id\": \"https://www.motiontheagency.com/#organization\"\n      },\n      \"url\": \"https://www.motiontheagency.com/customer-stories/primer\"\n    },\n    {\n      \"@id\": \"https://www.motiontheagency.com/customer-stories/primer#breadcrumb\",\n      \"@type\": \"BreadcrumbList\",\n      \"itemListElement\": [\n        {\n          \"@type\": \"ListItem\",\n          \"item\": \"https://www.motiontheagency.com/\",\n          \"name\": \"Home\",\n          \"position\": 1\n        },\n        {\n          \"@type\": \"ListItem\",\n          \"item\": \"https://www.motiontheagency.com/resources/customer-stories\",\n          \"name\": \"Customer Stories\",\n          \"position\": 2\n        },\n        {\n          \"@type\": \"ListItem\",\n          \"item\": \"https://www.motiontheagency.com/customer-stories/primer\",\n          \"name\": \"Primer\",\n          \"position\": 3\n        }\n      ]\n    }\n  ]\n}\n</script>\n  <meta name=\"twitter:title\" content=\"How We Made Primer's Product Launch Videos | Motion\">\n<meta name=\"twitter:description\" content=\"Primer, a VC-backed payments platform, returned to Motion across 3 projects. See how we turned their product launches into animated videos that convert.\">\n<meta name=\"twitter:image\" content=\"https://cdn.prod.website-files.com/66ebfb6ec8f20d5eda50eb34/67640cd602bfd87616624e43_Luniate%20-%20BentoBox%2003.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">",
