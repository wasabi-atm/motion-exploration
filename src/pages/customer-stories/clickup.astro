<style is:inline>
/* ==================================================
   MAIN VERTICAL SLIDER VIEWPORT
================================================== */
.project-slider {
  position: relative;
  width: 100%;
  height: 720px;
  overflow: hidden;
}
/* ==================================================
   MOVING TRACK
================================================== */
.project-slider-track {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  display: flex;
  flex-direction: column;
  will-change: transform;
  transition:
    transform 1200ms
    cubic-bezier(
      0.22,
      1,
      0.36,
      1
    );
}
/* Disable animation during the invisible loop reset */
.project-slider-track.is-resetting {
  transition: none;
}
/* ==================================================
   SLIDE POSITIONING SLOT
   This controls the distance between cards.
================================================== */
.project-slide {
  width: 100%;
  height: 240px;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}
/* ==================================================
   ACTUAL PROJECT CARD
================================================== */
.project-card {
  position: relative;
  width: 88%;
  max-width: 680px;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  opacity: 0;
  visibility: hidden;
  transform:
    scale(0.7);
  filter:
    brightness(0.35);
  transition:
    opacity 1200ms ease,
    visibility 1200ms ease,
    filter 1200ms ease,
    transform 1200ms
    cubic-bezier(
      0.22,
      1,
      0.36,
      1
    );
  will-change:
    transform,
    opacity,
    filter;
}
/* ==================================================
   PREVIOUS CARD
   Visible above the active card.
================================================== */
.project-slide.is-previous
.project-card {
  opacity: 0.3;
  visibility: visible;
  transform:
    scale(0.73);
  filter:
    brightness(0.52);
}
/* ==================================================
   ACTIVE CENTER CARD
================================================== */
.project-slide.is-active
.project-card {
  opacity: 1;
  visibility: visible;
  transform:
    scale(1);
  filter:
    brightness(1);
  z-index: 5;
}
/* ==================================================
   NEXT CARD
   Visible below the active card.
================================================== */
.project-slide.is-next
.project-card {
  opacity: 0.3;
  visibility: visible;
  transform:
    scale(0.73);
  filter:
    brightness(0.52);
}
/* ==================================================
   KEEP IMAGE / VIDEO NORMAL
================================================== */
.project-card img,
.project-card video {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
/* ==================================================
   SOFT TOP AND BOTTOM FADES
   Creates the recessed appearance
   from your Figma design.
================================================== */
.project-slider::before,
.project-slider::after {
  content: "";
  position: absolute;
  left: 0;
  width: 100%;
  height: 130px;
  z-index: 20;
  pointer-events: none;
}
.project-slider::before {
  top: 0;
  background:
    linear-gradient(
      to bottom,
      #080610 0%,
      rgba(
        8,
        6,
        16,
        0
      ) 100%
    );
}
.project-slider::after {
  bottom: 0;
  background:
    linear-gradient(
      to top,
      #080610 0%,
      rgba(
        8,
        6,
        16,
        0
      ) 100%
    );
}
/* ==================================================
   TABLET
================================================== */
@media screen and
(max-width: 991px) {
