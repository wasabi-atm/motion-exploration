                        </div>
                        <div class="text-16-150 fit-content"><strong>= $478,020</strong></div>
                      </div>
                      <div class="w-layout-hflex flex-h between">
                        <div class="w-layout-hflex flex-h short"><img src="/images/dot.svg" loading="eager" alt="" class="dots">
                          <div class="text-16-150"><strong>3</strong> x 90s premium animated videos | $5,800</div>
                        </div>
                        <div class="text-16-150"><strong>= $17,400</strong></div>
                      </div>
                      <div class="w-layout-hflex flex-h between">
                        <div class="w-layout-hflex flex-h short"><img src="/images/dot.svg" loading="eager" alt="" class="dots">
                          <div class="text-16-150"><strong>2</strong> x 150s premium animated videos | $6,860</div>
                        </div>
                        <div class="text-16-150"><strong>= $13,720</strong></div>
                      </div>
                      <div class="w-layout-hflex flex-h between">
                        <div class="w-layout-hflex flex-h short"><img src="/images/dot.svg" loading="eager" alt="" class="dots">
