/* ==================================================
   MAIN VERTICAL SLIDER VIEWPORT
================================================== */
.project-slider {
  position: relative;
  width: 100%;
  height: 760px;
  overflow: hidden;
}
/* ==================================================
   MOVING TRACK
================================================== */
.project-slider-track {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  display: flex;
  flex-direction: column;
  will-change: transform;
  transition:
    transform 900ms
    cubic-bezier(
      0.22,
      1,
      0.36,
      1
    );
}
/* Disable animation during the invisible loop reset */
.project-slider-track.is-resetting {
  transition: none;
}
/* ==================================================
   SLIDE POSITIONING SLOT
   This controls the distance between cards.
================================================== */
.project-slide {
  width: 100%;
  height: 240px;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}
/* ==================================================
   ACTUAL PROJECT CARD
================================================== */
.project-card {
  position: relative;
  width: 88%;
  max-width: 680px;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  opacity: 0;
  visibility: hidden;
  transform:
    scale(0.7);
  filter:
    brightness(0.35);
  transition:
    opacity 900ms ease,
    visibility 900ms ease,
    filter 900ms ease,
    transform 900ms
    cubic-bezier(
      0.22,
      1,
      0.36,
      1
    );
  will-change:
    transform,
    opacity,
    filter;
}
/* ==================================================
   PREVIOUS CARD
   Visible above the active card.
================================================== */
.project-slide.is-previous
.project-card {
  opacity: 0.3;
  visibility: visible;
  transform:
    scale(0.73);
  filter:
    brightness(0.52);
}
/* ==================================================
