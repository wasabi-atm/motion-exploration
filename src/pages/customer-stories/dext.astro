   \"author\": {\n        \"@id\": \"https://www.motiontheagency.com/#organization\"\n      },\n      \"breadcrumb\": {\n        \"@id\": \"https://www.motiontheagency.com/customer-stories/dext#breadcrumb\"\n      },\n      \"datePublished\": \"2026-07-09T00:00:00+00:00\",\n      \"description\": \"Dext needed to explain a complex fintech product without losing viewers in the first few seconds. Here's how we brought speed, scale, and strong craft to the work.\",\n      \"headline\": \"Dext Fintech Explainer Video Case Study\",\n      \"inLanguage\": \"en\",\n      \"isPartOf\": {\n        \"@id\": \"https://www.motiontheagency.com/#website\"\n      },\n      \"mainEntityOfPage\": {\n        \"@id\": \"https://www.motiontheagency.com/customer-stories/dext\",\n        \"@type\": \"WebPage\"\n      },\n      \"publisher\": {\n        \"@id\": \"https://www.motiontheagency.com/#organization\"\n      },\n      \"url\": \"https://www.motiontheagency.com/customer-stories/dext\"\n    },\n    {\n      \"@id\": \"https://www.motiontheagency.com/customer-stories/dext#breadcrumb\",\n      \"@type\": \"BreadcrumbList\",\n      \"itemListElement\": [\n        {\n          \"@type\": \"ListItem\",\n          \"item\": \"https://www.motiontheagency.com/\",\n          \"name\": \"Home\",\n          \"position\": 1\n        },\n        {\n          \"@type\": \"ListItem\",\n          \"item\": \"https://www.motiontheagency.com/resources/customer-stories\",\n          \"name\": \"Customer Stories\",\n          \"position\": 2\n        },\n        {\n          \"@type\": \"ListItem\",\n          \"item\": \"https://www.motiontheagency.com/customer-stories/dext\",\n          \"name\": \"Dext\",\n          \"position\": 3\n        }\n      ]\n    }\n  ]\n}\n</script>\n  \n<!--  <link\n  rel=\"stylesheet\"\n  href=\"https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css\"\n/>\n<style>\n/* =========================================\n   MAIN VERTICAL SLIDER VIEWPORT\n========================================= */\n.project-slider {\n  position: relative;\n  width: 100%;\n  height: 760px;\n  overflow: hidden;\n}\n/* =========================================\n   SWIPER WRAPPER\n========================================= */\n.project-slider .swiper-wrapper {\n  height: 100%;\n}\n/* =========================================\n   SWIPER POSITIONING SLIDES\n   Do not fade or scale these.\n========================================= */\n.project-slider .swiper-slide {\n  width: 100%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  opacity: 1 !important;\n  visibility: visible !important;\n  filter: none !important;\n}\n/* =========================================\n   DEFAULT INACTIVE CARD\n========================================= */\n.project-slider .project-card {\n  width: 88%;\n  max-width: 680px;\n  opacity: 0.16 !important;\n  visibility: visible !important;\n  transform:\n    scale(0.78) !important;\n  filter:\n    brightness(0.5) !important;\n  transition:\n    opacity 800ms ease,\n    filter 800ms ease,\n    transform 800ms\n    cubic-bezier(\n      0.22,\n      1,\n      0.36,\n      1\n    );\n  will-change:\n    opacity,\n    transform,\n    filter;\n}\n/* =========================================\n   PREVIOUS AND NEXT CARDS\n========================================= */\n.project-slider\n.swiper-slide-prev\n.project-card,\n.project-slider\n.swiper-slide-next\n.project-card {\n  opacity: 0.36 !important;\n  transform:\n    scale(0.84) !important;\n  filter:\n    brightness(0.68) !important;\n}\n/* =========================================\n   ACTIVE MIDDLE CARD\n========================================= */\n.project-slider\n.swiper-slide-active\n.project-card {\n  opacity: 1 !important;\n  visibility: visible !important;\n  transform:\n    scale(1) !important;\n  filter:\n    brightness(1) !important;\n  position: relative;\n  z-index: 10;\n}\n/* =========================================\n   ACTIVE IMAGE / VIDEO RESET\n========================================= */\n.project-slider\n.swiper-slide-active\n.project-card img,\n.project-slider\n.swiper-slide-active\n.project-card video {\n  opacity: 1 !important;\n  visibility: visible !important;\n  filter: none !important;\n}\n/* =========================================\n   TABLET\n========================================= */\n@media screen and\n(max-width: 991px) {\n  .project-slider {\n    height: 650px;\n  }\n  .project-slider\n  .project-card {\n    width: 92%;\n  }\n}\n/* =========================================\n   MOBILE\n========================================= */\n@media screen and\n(max-width: 767px) {\n  .project-slider {\n    height: 520px;\n  }\n  .project-slider\n  .project-card {\n    width: 94%;\n  }\n}\n</style>  -->\n  <meta name=\"twitter:title\" content=\"Dext Fintech Explainer Video Case Study | Motion The Agency\">\n<meta name=\"twitter:description\" content=\"Dext needed to explain a complex fintech product without losing viewers in the first few seconds. Here's how we brought speed, scale, and strong craft to the work.\">\n<meta name=\"twitter:image\" content=\"https://cdn.prod.website-files.com/66ebfb6ec8f20d5eda50eb34/67640cd602bfd87616624e43_Luniate%20-%20BentoBox%2003.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">",
    "bodyEnd": "\n<style>\n/* ==================================================\n   MAIN VERTICAL SLIDER VIEWPORT\n================================================== */\n.project-slider {\n  position: relative;\n  width: 100%;\n  height: 760px;\n  overflow: hidden;\n}\n/* ==================================================\n   MOVING TRACK\n================================================== */\n.project-slider-track {\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  display: flex;\n  flex-direction: column;\n  will-change: transform;\n  transition:\n    transform 900ms\n    cubic-bezier(\n      0.22,\n      1,\n      0.36,\n      1\n    );\n}\n/* Disable animation during the invisible loop reset */\n.project-slider-track.is-resetting {\n  transition: none;\n}\n/* ==================================================\n   SLIDE POSITIONING SLOT\n   This controls the distance between cards.\n================================================== */\n.project-slide {\n  width: 100%;\n  height: 240px;\n  flex: none;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  pointer-events: none;\n}\n/* ==================================================\n   ACTUAL PROJECT CARD\n================================================== */\n.project-card {\n  position: relative;\n  width: 88%;\n  max-width: 680px;\n  aspect-ratio: 16 / 9;\n  overflow: hidden;\n  opacity: 0;\n  visibility: hidden;\n  transform:\n    scale(0.7);\n  filter:\n    brightness(0.35);\n  transition:\n    opacity 900ms ease,\n    visibility 900ms ease,\n    filter 900ms ease,\n    transform 900ms\n    cubic-bezier(\n      0.22,\n      1,\n      0.36,\n      1\n    );\n  will-change:\n    transform,\n    opacity,\n    filter;\n}\n/* ==================================================\n   PREVIOUS CARD\n   Visible above the active card.\n================================================== */\n.project-slide.is-previous\n.project-card {\n  opacity: 0.3;\n  visibility: visible;\n  transform:\n    scale(0.73);\n  filter:\n    brightness(0.52);\n}\n/* ==================================================\n   ACTIVE CENTER CARD\n================================================== */\n.project-slide.is-active\n.project-card {\n  opacity: 1;\n  visibility: visible;\n  transform:\n    scale(1);\n  filter:\n    brightness(1);\n  z-index: 5;\n}\n/* ==================================================\n   NEXT CARD\n   Visible below the active card.\n================================================== */\n.project-slide.is-next\n.project-card {\n  opacity: 0.3;\n  visibility: visible;\n  transform:\n    scale(0.73);\n  filter:\n    brightness(0.52);\n}\n/* ==================================================\n   KEEP IMAGE / VIDEO NORMAL\n================================================== */\n.project-card img,\n.project-card video {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n/* ==================================================\n   SOFT TOP AND BOTTOM FADES\n   Creates the recessed appearance\n   from your Figma design.\n================================================== */\n.project-slider::before,\n.project-slider::after {\n  content: \"\";\n  position: absolute;\n  left: 0;\n  width: 100%;\n  height: 130px;\n  z-index: 20;\n  pointer-events: none;\n}\n.project-slider::before {\n  top: 0;\n  background:\n    linear-gradient(\n      to bottom,\n      #080610 0%,\n      rgba(\n        8,\n        6,\n        16,\n        0\n      ) 100%\n    );\n}\n.project-slider::after {\n  bottom: 0;\n  background:\n    linear-gradient(\n      to top,\n      #080610 0%,\n      rgba(\n        8,\n        6,\n        16,\n        0\n      ) 100%\n    );\n}\n/* ==================================================\n   TABLET\n================================================== */\n@media screen and\n(max-width: 991px) {\n  .project-slider {\n    height: 650px;\n  }\n  .project-slide {\n    height: 260px;\n  }\n  .project-card {\n    width: 92%;\n  }\n}\n/* ==================================================\n   MOBILE\n================================================== */\n@media screen and\n(max-width: 767px) {\n  .project-slider {\n    height: 540px;\n  }\n  .project-slide {\n    height: 180px;\n  }\n  .project-card {\n    width: 94%;\n  }\n}\n</style>\n  <script>\ndocument.addEventListener(\n  \"DOMContentLoaded\",\n  function () {\n    const sliders =\n      document.querySelectorAll(\n        \".project-slider\"\n      );\n    sliders.forEach(\n      function (slider) {\n        const track =\n          slider.querySelector(\n            \".project-slider-track\"\n          );\n        if (!track) return;\n        const originalSlides =\n          Array.from(\n            track.children\n          );\n        const slideCount =\n          originalSlides.length;\n        if (\n          slideCount < 2\n        ) {\n          return;\n        }\n        /* ==========================================\n           CREATE THREE COPIES\n           This gives us enough content for a\n           seamless infinite loop.\n        ========================================== */\n        const firstSet =\n          originalSlides.map(\n            function (slide) {\n              return slide.cloneNode(\n                true\n              );\n            }\n          );\n        const thirdSet =\n          originalSlides.map(\n            function (slide) {\n              return slide.cloneNode(\n                true\n              );\n            }\n          );\n        track.replaceChildren(\n          ...firstSet,\n          ...originalSlides,\n          ...thirdSet\n        );\n        const allSlides =\n          Array.from(\n            track.children\n          );\n        /* Start from the middle copy */\n        let activeIndex =\n          slideCount;\n        let autoplay;\n        /* ==========================================\n           GET THE CURRENT SLIDE HEIGHT\n        ========================================== */\n        function getSlideHeight() {\n          return (\n            allSlides[0]\n              .getBoundingClientRect()\n              .height\n          );\n        }\n        /* ==========================================\n           UPDATE ACTIVE CARD STATES\n        ========================================== */\n        function updateStates() {\n          allSlides.forEach(\n            function (slide) {\n              slide.classList.remove(\n                \"is-previous\",\n                \"is-active\",\n                \"is-next\"\n              );\n            }\n          );\n          if (\n            allSlides[\n              activeIndex - 1\n            ]\n          ) {\n            allSlides[\n              activeIndex - 1\n            ]\n            .classList\n            .add(\n              \"is-previous\"\n            );\n          }\n          if (\n            allSlides[\n              activeIndex\n            ]\n          ) {\n            allSlides[\n              activeIndex\n            ]\n            .classList\n            .add(\n              \"is-active\"\n            );\n          }\n          if (\n            allSlides[\n              activeIndex + 1\n            ]\n          ) {\n            allSlides[\n              activeIndex + 1\n            ]\n            .classList\n            .add(\n              \"is-next\"\n            );\n          }\n        }\n        /* ==========================================\n           CENTER THE ACTIVE CARD\n        ========================================== */\n        function updatePosition(\n          animate\n        ) {\n          const slideHeight =\n            getSlideHeight();\n          const sliderHeight =\n            slider\n              .getBoundingClientRect()\n              .height;\n          const position =\n            sliderHeight / 2\n            -\n            (\n              activeIndex\n              *\n              slideHeight\n            )\n            -\n            (\n              slideHeight / 2\n            );\n          if (\n            animate === false\n          ) {\n            track.classList.add(\n              \"is-resetting\"\n            );\n          }\n          else {\n            track.classList.remove(\n              \"is-resetting\"\n            );\n          }\n          track.style.transform =\n            \"translate3d(\"\n            +\n            \"0,\"\n            +\n            position\n            +\n            \"px,\"\n            +\n            \"0\"\n            +\n            \")\";\n          if (\n            animate === false\n          ) {\n            requestAnimationFrame(\n              function () {\n                requestAnimationFrame(\n                  function () {\n                    track\n                      .classList\n                      .remove(\n                        \"is-resetting\"\n                      );\n                  }\n                );\n              }\n            );\n          }\n        }\n        /* ==========================================\n           MOVE TO NEXT PROJECT\n        ========================================== */\n        function nextSlide() {\n          activeIndex++;\n          updateStates();\n          updatePosition(\n            true\n          );\n        }\n        /* ==========================================\n           RESET TO THE IDENTICAL MIDDLE COPY\n           The user cannot see this reset.\n        ========================================== */\n        track.addEventListener(\n          \"transitionend\",\n          function (event) {\n            if (\n              event.propertyName\n              !==\n              \"transform\"\n            ) {\n              return;\n            }\n            if (\n              activeIndex\n              >=\n              slideCount * 2\n            ) {\n              activeIndex =\n                slideCount;\n              updateStates();\n              updatePosition(\n                false\n              );\n            }\n          }\n        );\n        /* ==========================================\n           AUTOPLAY\n        ========================================== */\n        function startAutoplay() {\n          clearInterval(\n            autoplay\n          );\n          autoplay =\n            setInterval(\n              nextSlide,\n              3500\n            );\n        }\n        /* ==========================================\n           INITIAL POSITION\n        ========================================== */\n        updateStates();\n        updatePosition(\n          false\n        );\n        startAutoplay();\n        /* ==========================================\n           RECALCULATE ON WINDOW RESIZE\n        ========================================== */\n        window.addEventListener(\n          \"resize\",\n          function () {\n            updatePosition(\n              false\n            );\n          }\n        );\n      }\n    );\n  }\n);\n</script>\n  <script>\nvar Webflow = Webflow || [];\nWebflow.push(function () {\nvar tabTimeout;\nclearTimeout(tabTimeout);\ntabLoop();\nfunction tabLoop() {\ntabTimeout = setTimeout(function() {\nvar $next = $('.tabs-list').children('.w--current:first').next();\nif($next.length) {\nif ($(\".menu-button\").hasClass(\"w--open\")) {\ntabLoop();\n}else{\n$next.removeAttr(\"href\").click();\n}\n} else {\nif ($(\".menu-button\").hasClass(\"w--open\")){\ntabLoop();\n}else{\n$('.tab-text-box-kuberno:first').removeAttr(\"href\").click();\n}\n}\n}, 8000); // 8 seconds\n}\n$('.tab-text-box-kuberno').click(function() {\nclearTimeout(tabTimeout);\ntabLoop();\n});\n});\n</script>\n  <script>\nvar Webflow = Webflow || [];\nWebflow.push(function () {\nvar tabTimeout;\nclearTimeout(tabTimeout);\ntabLoop();\nfunction tabLoop() {\ntabTimeout = setTimeout(function() {\nvar $next = $('.tabs-list').children('.w--current:first').next();\nif($next.length) {\nif ($(\".menu-button\").hasClass(\"w--open\")) {\ntabLoop();\n}else{\n$next.removeAttr(\"href\").click();\n}\n} else {\nif ($(\".menu-button\").hasClass(\"w--open\")){\ntabLoop();\n}else{\n$('.tab-text-box:first').removeAttr(\"href\").click();\n}\n}\n}, 8000); // 8 seconds\n}\n$('.tab-text-box').click(function() {\nclearTimeout(tabTimeout);\ntabLoop();\n});\n});\n</script>\n  <script>\n$(document).ready(function() {\n$('#toggle-1').addClass('w--open');\n$('#dropdown-list-1').addClass('w--open');\n$('.dropdown-wrap').on('click',function() {\n $('#toggle-1').removeClass('w--open');\n $('#dropdown-list-1').removeClass('w--open');\n });\n});\n</script>\n  ",
    "bodyStart": "<script>document.body.className=\"body\";</script>"
  }
};
