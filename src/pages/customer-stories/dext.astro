                      <div class="card is-block"><video muted="" loop="" webkit-playsinline="" playsinline="" autoplay="true" class="video-card-visual__video _w-100 rounded-12">
                          <source src="https://motiontheagency.b-cdn.net/Case%20studies/Dext/clip/clip%202.mp4" type="video/mp4">
                        </video></div>
