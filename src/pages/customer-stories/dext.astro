================================================== */
.project-slide.is-active
.project-card {
  opacity: 1;
  visibility: visible;
  transform:
    scale(1);
  filter:
    brightness(1);
  z-index: 5;
}
/* ==================================================
   NEXT CARD
   Visible below the active card.
================================================== */
.project-slide.is-next
.project-card {
  opacity: 0.3;
