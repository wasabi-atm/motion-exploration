  <script is:inline>
document.addEventListener(
  "DOMContentLoaded",
  function () {
    const sliders =
      document.querySelectorAll(
        ".project-slider"
      );
    sliders.forEach(
      function (slider) {
        const track =
          slider.querySelector(
            ".project-slider-track"
          );
        if (!track) return;
        const originalSlides =
          Array.from(
            track.children
          );
        const slideCount =
          originalSlides.length;
        if (
          slideCount < 2
        ) {
          return;
        }
        /* ==========================================
           CREATE THREE COPIES
           This gives us enough content for a
           seamless infinite loop.
        ========================================== */
        const firstSet =
          originalSlides.map(
            function (slide) {
              return slide.cloneNode(
                true
              );
            }
          );
        const thirdSet =
          originalSlides.map(
            function (slide) {
              return slide.cloneNode(
                true
              );
            }
          );
        track.replaceChildren(
          ...firstSet,
          ...originalSlides,
          ...thirdSet
        );
        const allSlides =
          Array.from(
            track.children
          );
        /* Start from the middle copy */
        let activeIndex =
          slideCount;
        let autoplay;
        /* ==========================================
           GET THE CURRENT SLIDE HEIGHT
        ========================================== */
        function getSlideHeight() {
          return (
            allSlides[0]
              .getBoundingClientRect()
              .height
          );
        }
        /* ==========================================
           UPDATE ACTIVE CARD STATES
        ========================================== */
        function updateStates() {
          allSlides.forEach(
            function (slide) {
              slide.classList.remove(
                "is-previous",
                "is-active",
                "is-next"
              );
            }
          );
          if (
            allSlides[
              activeIndex - 1
            ]
          ) {
            allSlides[
              activeIndex - 1
            ]
            .classList
            .add(
              "is-previous"
            );
          }
          if (
            allSlides[
              activeIndex
            ]
          ) {
            allSlides[
              activeIndex
            ]
            .classList
            .add(
              "is-active"
            );
          }
          if (
            allSlides[
              activeIndex + 1
            ]
          ) {
            allSlides[
              activeIndex + 1
            ]
            .classList
            .add(
              "is-next"
            );
          }
        }
        /* ==========================================
           CENTER THE ACTIVE CARD
        ========================================== */
        function updatePosition(
          animate
        ) {
          const slideHeight =
            getSlideHeight();
          const sliderHeight =
            slider
              .getBoundingClientRect()
              .height;
          const position =
            sliderHeight / 2
            -
            (
              activeIndex
              *
              slideHeight
            )
            -
            (
              slideHeight / 2
            );
          if (
            animate === false
          ) {
            track.classList.add(
              "is-resetting"
            );
          }
          else {
            track.classList.remove(
              "is-resetting"
            );
          }
          track.style.transform =
            "translate3d("
            +
            "0,"
            +
            position
            +
            "px,"
            +
            "0"
            +
            ")";
          if (
            animate === false
          ) {
            requestAnimationFrame(
              function () {
                requestAnimationFrame(
                  function () {
                    track
                      .classList
                      .remove(
                        "is-resetting"
                      );
                  }
                );
              }
            );
          }
        }
        /* ==========================================
           MOVE TO NEXT PROJECT
        ========================================== */
        function nextSlide() {
          activeIndex++;
          updateStates();
          updatePosition(
            true
          );
        }
        /* ==========================================
           RESET TO THE IDENTICAL MIDDLE COPY
           The user cannot see this reset.
        ========================================== */
        track.addEventListener(
          "transitionend",
          function (event) {
            if (
              event.propertyName
              !==
              "transform"
            ) {
              return;
            }
            if (
              activeIndex
              >=
              slideCount * 2
            ) {
              activeIndex =
                slideCount;
              updateStates();
              updatePosition(
                false
              );
            }
          }
        );
        /* ==========================================
           AUTOPLAY
        ========================================== */
        function startAutoplay() {
          clearInterval(
            autoplay
          );
          autoplay =
            setInterval(
              nextSlide,
              3500
            );
        }
        /* ==========================================
           INITIAL POSITION
        ========================================== */
        updateStates();
        updatePosition(
          false
        );
        startAutoplay();
        /* ==========================================
           RECALCULATE ON WINDOW RESIZE
        ========================================== */
        window.addEventListener(
          "resize",
          function () {
            updatePosition(
              false
            );
          }
        );
      }
    );
  }
);
</script>
