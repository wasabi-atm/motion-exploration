            <div class="card-contaiiner order-0">
              <div wb-component="smart-animate" class="card transparent">
                <div class="card-content-padding-40 top-60 quote"><img src="/images/tick.svg" loading="lazy" alt="" class="img-float quote bot"><img src="/images/tick.svg" loading="lazy" alt="" class="img-float quote top">
                  <div class="gap-32 flex-v">
                    <div wb-split-type="words" wb-component="split-text" wb-duration="0.2" class="text-24 center">The primary value you give us is speed and scale; we have motion capability in-house but MTA allows us to move faster and run more in parallel than we could alone.</div>
                    <div wb-interval-delay="0.1" wb-component="smart-animate" class="w-layout-hflex flex-h _16 center"><img src="/images/testi-image.avif" loading="eager" width="48" height="48" alt="" srcset="/images/testi-image-p-500.avif 500w, /images/testi-image.avif 800w" sizes="48px" class="testimonial-profile">
