                  <script is:inline>
document.addEventListener("DOMContentLoaded", function () {
    const settings = {
        duration: 12000,
        pauseOnHover: true,
        fadeSize: 100,
        fadeColor: "rgba(9, 6, 29, 1)"
    };
    function initVerticalSlider(index = "") {
        const suffix = index ? `-${index}` : "";
        const leftContainer = document.querySelector(
            `[slider="left${suffix}"]`
        );
        const rightContainer = document.querySelector(
            `[slider="right${suffix}"]`
        );
        if (!leftContainer && !rightContainer) return;
        function setupColumn(container, direction) {
            if (!container) return;
            if (container.dataset.verticalSliderInitialized === "true") {
                return;
            }
            container.dataset.verticalSliderInitialized = "true";
            /*
            =========================================
            GET ORIGINAL SLIDES
            =========================================
            */
            const originals = Array.from(container.children).filter(
                child =>
                    child.getAttribute("slide") ===
                    `duplicate${suffix}`
            );
            if (!originals.length) return;
            /*
            =========================================
            READ EXISTING WEBFLOW STYLES
            =========================================
            */
            const computed =
                window.getComputedStyle(container);
            const gap =
                parseFloat(computed.rowGap) ||
                parseFloat(computed.gap) ||
                0;
            /*
            =========================================
            CAPTURE CURRENT NATIVE HEIGHT
            AFTER WEBFLOW HAS RENDERED
            =========================================
            */
            const initialNativeHeight =
                container.offsetHeight;
            /*
            =========================================
            OUTER CONTAINER
            =========================================
            */
            container.style.position = "relative";
            container.style.overflow = "hidden";
            /*
            =========================================
            CREATE TRACK
            =========================================
            */
            const track =
                document.createElement("div");
            track.setAttribute(
                "data-vertical-slider-track",
                ""
            );
            track.style.position = "relative";
            track.style.width = "100%";
            track.style.display = "flex";
            track.style.flexDirection = "column";
            track.style.gap = `${gap}px`;
            track.style.willChange = "transform";
            /*
            =========================================
            FIRST SEQUENCE
            =========================================
            */
            const sequenceOne =
                document.createElement("div");
            sequenceOne.style.display = "flex";
            sequenceOne.style.flexDirection = "column";
            sequenceOne.style.width = "100%";
            sequenceOne.style.flexShrink = "0";
            sequenceOne.style.gap =
                `${gap}px`;
            originals.forEach(slide => {
                sequenceOne.appendChild(slide);
            });
            /*
            =========================================
            SECOND SEQUENCE
            =========================================
            */
            const sequenceTwo =
                sequenceOne.cloneNode(true);
            track.appendChild(sequenceOne);
            track.appendChild(sequenceTwo);
            container.appendChild(track);
            /*
            =========================================
            RESTORE / LOCK NATIVE FRAME HEIGHT
            =========================================
            */
            requestAnimationFrame(() => {
                if (initialNativeHeight > 0) {
                    container.style.height =
                        `${initialNativeHeight}px`;
                }
            });
            /*
            =========================================
            FADE MASKS
            =========================================
            */
            const fadeTop =
                document.createElement("div");
            const fadeBottom =
                document.createElement("div");
            fadeTop.setAttribute(
                "data-carousel-fade",
                "top"
            );
            fadeBottom.setAttribute(
                "data-carousel-fade",
                "bottom"
            );
            [fadeTop, fadeBottom].forEach(fade => {
                fade.style.position = "absolute";
                fade.style.left = "0";
                fade.style.width = "100%";
                fade.style.height =
                    `${settings.fadeSize}px`;
                fade.style.pointerEvents = "none";
                fade.style.zIndex = "10";
            });
            fadeTop.style.top = "0";
            fadeTop.style.background =
                `linear-gradient(
                    to bottom,
                    ${settings.fadeColor} 0%,
                    rgba(9, 6, 29, 0.72) 40%,
                    rgba(9, 6, 29, 0) 100%
                )`;
            fadeBottom.style.bottom = "0";
            fadeBottom.style.background =
                `linear-gradient(
                    to top,
                    ${settings.fadeColor} 0%,
                    rgba(9, 6, 29, 0.72) 40%,
                    rgba(9, 6, 29, 0) 100%
                )`;
            container.appendChild(fadeTop);
            container.appendChild(fadeBottom);
            /*
            =========================================
            MEASURE LOOP HEIGHT
            =========================================
            */
            function getSequenceHeight() {
                const sequenceHeight =
                    sequenceOne.getBoundingClientRect().height;
                return sequenceHeight + gap;
            }
            let sequenceHeight = 0;
            let y = 0;
            let previousTime = null;
            let animationFrame = null;
            let paused = false;
            /*
            =========================================
            RESET
            =========================================
            */
            function resetPosition() {
                sequenceHeight =
                    getSequenceHeight();
                if (!sequenceHeight) return;
                if (direction === "up") {
                    y = 0;
                } else {
                    y = -sequenceHeight;
                }
                track.style.transform =
                    `translate3d(0, ${y}px, 0)`;
            }
            /*
            =========================================
            ANIMATION
            =========================================
            */
            function animate(time) {
                if (previousTime === null) {
                    previousTime = time;
                }
                const delta =
                    time - previousTime;
                previousTime = time;
                if (
                    !paused &&
                    sequenceHeight > 0
                ) {
                    const pixelsPerMs =
                        sequenceHeight /
                        settings.duration;
                    const movement =
                        pixelsPerMs * delta;
                    /*
                    LEFT COLUMN MOVES UP
                    */
                    if (direction === "up") {
                        y -= movement;
                        if (y <= -sequenceHeight) {
                            y += sequenceHeight;
                        }
                    }
                    /*
                    RIGHT COLUMN MOVES DOWN
                    */
                    else {
                        y += movement;
                        if (y >= 0) {
                            y -= sequenceHeight;
                        }
                    }
                    track.style.transform =
                        `translate3d(0, ${y}px, 0)`;
                }
                animationFrame =
                    requestAnimationFrame(animate);
            }
            /*
            =========================================
            PAUSE ON HOVER
            =========================================
            */
            if (settings.pauseOnHover) {
                container.addEventListener(
                    "mouseenter",
                    function () {
                        paused = true;
                    }
                );
                container.addEventListener(
                    "mouseleave",
                    function () {
                        paused = false;
                        previousTime = null;
                    }
                );
            }
            /*
            =========================================
            RECALCULATE AFTER IMAGE / VIDEO LOAD
            =========================================
            */
            function recalculate() {
                previousTime = null;
                resetPosition();
            }
            const media =
                container.querySelectorAll(
                    "img, video"
                );
            media.forEach(item => {
                if (
                    item.tagName === "IMG" &&
                    !item.complete
                ) {
                    item.addEventListener(
                        "load",
                        recalculate,
                        { once: true }
                    );
                }
                if (
                    item.tagName === "VIDEO"
                ) {
                    item.addEventListener(
                        "loadedmetadata",
                        recalculate,
                        { once: true }
                    );
                }
            });
            /*
            =========================================
            RESIZE
            =========================================
            */
            window.addEventListener(
                "resize",
                function () {
                    /*
                    Keep same native Webflow frame.
                    Only recalculate scrolling distance.
                    */
                    recalculate();
                }
            );
            /*
            =========================================
            START
            =========================================
            */
            requestAnimationFrame(() => {
                resetPosition();
                animationFrame =
                    requestAnimationFrame(animate);
            });
        }
        setupColumn(
            leftContainer,
            "up"
        );
        setupColumn(
            rightContainer,
            "down"
        );
    }
    /*
    =========================================
    DEFAULT
    =========================================
    */
    if (
        document.querySelector('[slider="left"]') ||
        document.querySelector('[slider="right"]')
    ) {
        initVerticalSlider();
    }
    /*
    =========================================
    NUMBERED SLIDERS
    =========================================
    */
    let index = 2;
    while (
        document.querySelector(
            `[slider="left-${index}"]`
        ) ||
        document.querySelector(
            `[slider="right-${index}"]`
        )
    ) {
        initVerticalSlider(index);
        index++;
    }
});
</script>
