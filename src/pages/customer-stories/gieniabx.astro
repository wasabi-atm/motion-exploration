nsform:\n    scale(0.73);\n  filter:\n    brightness(0.52);\n}\n/* ==================================================\n   ACTIVE CENTER CARD\n================================================== */\n.project-slide.is-active\n.project-card {\n  opacity: 1;\n  visibility: visible;\n  transform:\n    scale(1);\n  filter:\n    brightness(1);\n  z-index: 5;\n}\n/* ==================================================\n   NEXT CARD\n   Visible below the active card.\n================================================== */\n.project-slide.is-next\n.project-card {\n  opacity: 0.3;\n  visibility: visible;\n  transform:\n    scale(0.73);\n  filter:\n    brightness(0.52);\n}\n/* ==================================================\n   KEEP IMAGE / VIDEO NORMAL\n================================================== */\n.project-card img,\n.project-card video {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n/* ==================================================\n   SOFT TOP AND BOTTOM FADES\n   Creates the recessed appearance\n   from your Figma design.\n================================================== */\n.project-slider::before,\n.project-slider::after {\n  content: \"\";\n  position: absolute;\n  left: 0;\n  width: 100%;\n  height: 130px;\n  z-index: 20;\n  pointer-events: none;\n}\n.project-slider::before {\n  top: 0;\n  background:\n    linear-gradient(\n      to bottom,\n      #080610 0%,\n      rgba(\n        8,\n        6,\n        16,\n        0\n      ) 100%\n    );\n}\n.project-slider::after {\n  bottom: 0;\n  background:\n    linear-gradient(\n      to top,\n      #080610 0%,\n      rgba(\n        8,\n        6,\n        16,\n        0\n      ) 100%\n    );\n}\n/* ==================================================\n   TABLET\n================================================== */\n@media screen and\n(max-width: 991px) {\n  .project-slider {\n    height: 650px;\n  }\n  .project-slide {\n    height: 260px;\n  }\n  .project-card {\n    width: 92%;\n  }\n}\n/* ==================================================\n   MOBILE\n================================================== */\n@media screen and\n(max-width: 767px) {\n  .project-slider {\n    height: 540px;\n  }\n  .project-slide {\n    height: 180px;\n  }\n  .project-card {\n    width: 94%;\n  }\n}\n</style>\n  <script>\ndocument.addEventListener(\n  \"DOMContentLoaded\",\n  function () {\n    const sliders =\n      document.querySelectorAll(\n        \".project-slider\"\n      );\n    sliders.forEach(\n      function (slider) {\n        const track =\n          slider.querySelector(\n            \".project-slider-track\"\n          );\n        if (!track) return;\n        const originalSlides =\n          Array.from(\n            track.children\n          );\n        const slideCount =\n          originalSlides.length;\n        if (\n          slideCount < 2\n        ) {\n          return;\n        }\n        /* ==========================================\n           CREATE THREE COPIES\n           This gives us enough content for a\n           seamless infinite loop.\n        ========================================== */\n        const firstSet =\n          originalSlides.map(\n            function (slide) {\n              return slide.cloneNode(\n                true\n              );\n            }\n          );\n        const thirdSet =\n          originalSlides.map(\n            function (slide) {\n              return slide.cloneNode(\n                true\n              );\n            }\n          );\n        track.replaceChildren(\n          ...firstSet,\n          ...originalSlides,\n          ...thirdSet\n        );\n        const allSlides =\n          Array.from(\n            track.children\n          );\n        /* Start from the middle copy */\n        let activeIndex =\n          slideCount;\n        let autoplay;\n        /* ==========================================\n           GET THE CURRENT SLIDE HEIGHT\n        ========================================== */\n        function getSlideHeight() {\n          return (\n            allSlides[0]\n              .getBoundingClientRect()\n              .height\n          );\n        }\n        /* ==========================================\n           UPDATE ACTIVE CARD STATES\n        ========================================== */\n        function updateStates() {\n          allSlides.forEach(\n            function (slide) {\n              slide.classList.remove(\n                \"is-previous\",\n                \"is-active\",\n                \"is-next\"\n              );\n            }\n          );\n          if (\n            allSlides[\n              activeIndex - 1\n            ]\n          ) {\n            allSlides[\n              activeIndex - 1\n            ]\n            .classList\n            .add(\n              \"is-previous\"\n            );\n          }\n          if (\n            allSlides[\n              activeIndex\n            ]\n          ) {\n            allSlides[\n              activeIndex\n            ]\n            .classList\n            .add(\n              \"is-active\"\n            );\n          }\n          if (\n            allSlides[\n              activeIndex + 1\n            ]\n          ) {\n            allSlides[\n              activeIndex + 1\n            ]\n            .classList\n            .add(\n              \"is-next\"\n            );\n          }\n        }\n        /* ==========================================\n           CENTER THE ACTIVE CARD\n        ========================================== */\n        function updatePosition(\n          animate\n        ) {\n          const slideHeight =\n            getSlideHeight();\n          const sliderHeight =\n            slider\n              .getBoundingClientRect()\n              .height;\n          const position =\n            sliderHeight / 2\n            -\n            (\n              activeIndex\n              *\n              slideHeight\n            )\n            -\n            (\n              slideHeight / 2\n            );\n          if (\n            animate === false\n          ) {\n            track.classList.add(\n              \"is-resetting\"\n            );\n          }\n          else {\n            track.classList.remove(\n              \"is-resetting\"\n            );\n          }\n          track.style.transform =\n            \"translate3d(\"\n            +\n            \"0,\"\n            +\n            position\n            +\n            \"px,\"\n            +\n            \"0\"\n            +\n            \")\";\n          if (\n            animate === false\n          ) {\n            requestAnimationFrame(\n              function () {\n                requestAnimationFrame(\n                  function () {\n                    track\n                      .classList\n                      .remove(\n                        \"is-resetting\"\n                      );\n                  }\n                );\n              }\n            );\n          }\n        }\n        /* ==========================================\n           MOVE TO NEXT PROJECT\n        ========================================== */\n        function nextSlide() {\n          activeIndex++;\n          updateStates();\n          updatePosition(\n            true\n          );\n        }\n        /* ==========================================\n           RESET TO THE IDENTICAL MIDDLE COPY\n           The user cannot see this reset.\n        ========================================== */\n        track.addEventListener(\n          \"transitionend\",\n          function (event) {\n            if (\n              event.propertyName\n              !==\n              \"transform\"\n            ) {\n              return;\n            }\n            if (\n              activeIndex\n              >=\n              slideCount * 2\n            ) {\n              activeIndex =\n                slideCount;\n              updateStates();\n              updatePosition(\n                false\n              );\n            }\n          }\n        );\n        /* ==========================================\n           AUTOPLAY\n        ========================================== */\n        function startAutoplay() {\n          clearInterval(\n            autoplay\n          );\n          autoplay =\n            setInterval(\n              nextSlide,\n              3500\n            );\n        }\n        /* ==========================================\n           INITIAL POSITION\n        ========================================== */\n        updateStates();\n        updatePosition(\n          false\n        );\n        startAutoplay();\n        /* ==========================================\n           RECALCULATE ON WINDOW RESIZE\n        ========================================== */\n        window.addEventListener(\n          \"resize\",\n          function () {\n            updatePosition(\n              false\n            );\n          }\n        );\n      }\n    );\n  }\n);\n</script>\n  <script>\nvar Webflow = Webflow || [];\nWebflow.push(function () {\nvar tabTimeout;\nclearTimeout(tabTimeout);\ntabLoop();\nfunction tabLoop() {\ntabTimeout = setTimeout(function() {\nvar $next = $('.tabs-list').children('.w--current:first').next();\nif($next.length) {\nif ($(\".menu-button\").hasClass(\"w--open\")) {\ntabLoop();\n}else{\n$next.removeAttr(\"href\").click();\n}\n} else {\nif ($(\".menu-button\").hasClass(\"w--open\")){\ntabLoop();\n}else{\n$('.tab-text-box:first').removeAttr(\"href\").click();\n}\n}\n}, 8000); // 8 seconds\n}\n$('.tab-text-box').click(function() {\nclearTimeout(tabTimeout);\ntabLoop();\n});\n});\n</script>\n  ",
