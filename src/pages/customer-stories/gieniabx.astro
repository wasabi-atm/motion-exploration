  justify-content: center;
  pointer-events: none;
}
/* ==================================================
   ACTUAL PROJECT CARD
================================================== */
.project-card {
  position: relative;
  width: 88%;
  max-width: 680px;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  opacity: 0;
  visibility: hidden;
  transform:
    scale(0.7);
  filter:
    brightness(0.35);
  transition:
    opacity 1200ms ease,
    visibility 1200ms ease,
    filter 1200ms ease,
    transform 1200ms
    cubic-bezier(
      0.22,
      1,
      0.36,
      1
    );
  will-change:
    transform,
    opacity,
    filter;
}
/* ==================================================
   PREVIOUS CARD
   Visible above the active card.
================================================== */
.project-slide.is-previous
.project-card {
  opacity: 0.3;
  visibility: visible;
  transform:
    scale(0.73);
  filter:
    brightness(0.52);
}
/* ==================================================
   ACTIVE CENTER CARD
================================================== */
.project-slide.is-active
.project-card {
  opacity: 1;
  visibility: visible;
  transform:
    scale(1);
  filter:
    brightness(1);
  z-index: 5;
}
/* ==================================================
   NEXT CARD
   Visible below the active card.
================================================== */
.project-slide.is-next
.project-card {
  opacity: 0.3;
  visibility: visible;
  transform:
    scale(0.73);
  filter:
    brightness(0.52);
}
/* ==================================================
   KEEP IMAGE / VIDEO NORMAL
================================================== */
.project-card img,
.project-card video {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
/* ==================================================
   SOFT TOP AND BOTTOM FADES
   Creates the recessed appearance
   from your Figma design.
================================================== */
.project-slider::before,
.project-slider::after {
  content: "";
  position: absolute;
  left: 0;
  width: 100%;
  height: 130px;
  z-index: 20;
  pointer-events: none;
}
.project-slider::before {
  top: 0;
  background:
    linear-gradient(
      to bottom,
      #080610 0%,
      rgba(
        8,
        6,
        16,
        0
      ) 100%
    );
}
.project-slider::after {
  bottom: 0;
  background:
    linear-gradient(
      to top,
      #080610 0%,
      rgba(
        8,
        6,
        16,
        0
      ) 100%
    );
}
/* ==================================================
   TABLET
================================================== */
@media screen and
(max-width: 991px) {
  .project-slider {
    height: 650px;
  }
  .project-slide {
    height: 260px;
  }
  .project-card {
    width: 92%;
  }
}
/* ==================================================
   MOBILE
================================================== */
@media screen and
(max-width: 767px) {
  .project-slider {
    height: 540px;
  }
  .project-slide {
    height: 180px;
  }
  .project-card {
    width: 94%;
  }
}
</style>
  <script is:inline>
document.addEventListener(
  "DOMContentLoaded",
  function () {
    const sliders =
      document.querySelectorAll(
        ".project-slider"
      );
    sliders.forEach(
      function (slider) {
        const track =
          slider.querySelector(
            ".project-slider-track"
          );
        if (!track) return;
        const originalSlides =
          Array.from(
            track.children
          );
        const slideCount =
          originalSlides.length;
        if (
          slideCount < 2
        ) {
          return;
        }
        /* ==========================================
           CREATE THREE COPIES
           This gives us enough content for a
           seamless infinite loop.
        ========================================== */
        const firstSet =
          originalSlides.map(
            function (slide) {
              return slide.cloneNode(
                true
              );
            }
          );
        const thirdSet =
          originalSlides.map(
            function (slide) {
              return slide.cloneNode(
                true
              );
            }
          );
        track.replaceChildren(
          ...firstSet,
          ...originalSlides,
          ...thirdSet
        );
        const allSlides =
          Array.from(
            track.children
          );
        /* Start from the middle copy */
        let activeIndex =
          slideCount;
        let autoplay;
        /* ==========================================
           GET THE CURRENT SLIDE HEIGHT
        ========================================== */
        function getSlideHeight() {
          return (
            allSlides[0]
              .getBoundingClientRect()
              .height
          );
        }
        /* ==========================================
           UPDATE ACTIVE CARD STATES
        ========================================== */
        function updateStates() {
          allSlides.forEach(
            function (slide) {
              slide.classList.remove(
                "is-previous",
                "is-active",
                "is-next"
              );
            }
          );
          if (
            allSlides[
              activeIndex - 1
            ]
          ) {
            allSlides[
              activeIndex - 1
            ]
            .classList
            .add(
              "is-previous"
            );
          }
          if (
            allSlides[
              activeIndex
            ]
          ) {
            allSlides[
              activeIndex
            ]
            .classList
            .add(
              "is-active"
            );
          }
          if (
            allSlides[
              activeIndex + 1
            ]
          ) {
            allSlides[
              activeIndex + 1
            ]
            .classList
            .add(
              "is-next"
            );
          }
        }
        /* ==========================================
           CENTER THE ACTIVE CARD
        ========================================== */
        function updatePosition(
          animate
        ) {
          const slideHeight =
            getSlideHeight();
          const sliderHeight =
            slider
              .getBoundingClientRect()
              .height;
          const position =
            sliderHeight / 2
            -
            (
              activeIndex
              *
              slideHeight
            )
            -
            (
              slideHeight / 2
            );
          if (
            animate === false
          ) {
            track.classList.add(
              "is-resetting"
            );
          }
          else {
            track.classList.remove(
              "is-resetting"
            );
          }
          track.style.transform =
            "translate3d("
            +
            "0,"
            +
            position
            +
            "px,"
            +
            "0"
            +
            ")";
          if (
            animate === false
          ) {
            requestAnimationFrame(
              function () {
                requestAnimationFrame(
                  function () {
                    track
                      .classList
                      .remove(
                        "is-resetting"
                      );
                  }
                );
              }
            );
          }
        }
        /* ==========================================
           MOVE TO NEXT PROJECT
        ========================================== */
        function nextSlide() {
          activeIndex++;
          updateStates();
          updatePosition(
            true
          );
        }
        /* ==========================================
           RESET TO THE IDENTICAL MIDDLE COPY
           The user cannot see this reset.
        ========================================== */
        track.addEventListener(
          "transitionend",
          function (event) {
            if (
              event.propertyName
              !==
              "transform"
            ) {
              return;
            }
            if (
              activeIndex
              >=
              slideCount * 2
            ) {
              activeIndex =
                slideCount;
              updateStates();
              updatePosition(
                false
              );
            }
          }
        );
        /* ==========================================
           AUTOPLAY
        ========================================== */
        function startAutoplay() {
          clearInterval(
            autoplay
          );
          autoplay =
            setInterval(
              nextSlide,
              3500
            );
        }
        /* ==========================================
           INITIAL POSITION
        ========================================== */
        updateStates();
        updatePosition(
          false
        );
        startAutoplay();
        /* ==========================================
           RECALCULATE ON WINDOW RESIZE
        ========================================== */
        window.addEventListener(
          "resize",
          function () {
            updatePosition(
              false
            );
          }
        );
      }
    );
  }
);
</script>
  <script is:inline>
var Webflow = Webflow || [];
Webflow.push(function () {
var tabTimeout;
clearTimeout(tabTimeout);
tabLoop();
function tabLoop() {
tabTimeout = setTimeout(function() {
var $next = $('.tabs-list').children('.w--current:first').next();
if($next.length) {
if ($(".menu-button").hasClass("w--open")) {
tabLoop();
}else{
$next.removeAttr("href").click();
}
} else {
if ($(".menu-button").hasClass("w--open")){
tabLoop();
}else{
$('.tab-text-box:first').removeAttr("href").click();
}
}
}, 8000); // 8 seconds
}
$('.tab-text-box').click(function() {
