,\n      \"author\": {\n        \"@id\": \"https://www.motiontheagency.com/#organization\"\n      },\n      \"breadcrumb\": {\n        \"@id\": \"https://www.motiontheagency.com/customer-stories/kuberno#breadcrumb\"\n      },\n      \"datePublished\": \"2026-05-26T00:00:00+00:00\",\n      \"description\": \"How do you sell complex governance software? See how Kuberno worked with Motion to turn dense product detail into a story that converts.\",\n      \"headline\": \"Kuberno Case Study: SaaS Explainer Video by Motion\",\n      \"inLanguage\": \"en\",\n      \"isPartOf\": {\n        \"@id\": \"https://www.motiontheagency.com/#website\"\n      },\n      \"mainEntityOfPage\": {\n        \"@id\": \"https://www.motiontheagency.com/customer-stories/kuberno\",\n        \"@type\": \"WebPage\"\n      },\n      \"publisher\": {\n        \"@id\": \"https://www.motiontheagency.com/#organization\"\n      },\n      \"url\": \"https://www.motiontheagency.com/customer-stories/kuberno\"\n    },\n    {\n      \"@id\": \"https://www.motiontheagency.com/customer-stories/kuberno#breadcrumb\",\n      \"@type\": \"BreadcrumbList\",\n      \"itemListElement\": [\n        {\n          \"@type\": \"ListItem\",\n          \"item\": \"https://www.motiontheagency.com/\",\n          \"name\": \"Home\",\n          \"position\": 1\n        },\n        {\n          \"@type\": \"ListItem\",\n          \"item\": \"https://www.motiontheagency.com/resources/customer-stories\",\n          \"name\": \"Customer Stories\",\n          \"position\": 2\n        },\n        {\n          \"@type\": \"ListItem\",\n          \"item\": \"https://www.motiontheagency.com/customer-stories/kuberno\",\n          \"name\": \"Kuberno\",\n          \"position\": 3\n        }\n      ]\n    }\n  ]\n}\n</script>\n  <meta name=\"twitter:title\" content=\"Kuberno Case Study: SaaS Explainer Video by Motion\">\n<meta name=\"twitter:description\" content=\"How do you sell complex governance software? See how Kuberno worked with Motion to turn dense product detail into a story that converts.\">\n<meta name=\"twitter:image\" content=\"https://cdn.prod.website-files.com/66ebfb6ec8f20d5eda50eb34/67640cd602bfd87616624e43_Luniate%20-%20BentoBox%2003.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">",
    "bodyEnd": "\n<script>\nvar Webflow = Webflow || [];\nWebflow.push(function () {\nvar tabTimeout;\nclearTimeout(tabTimeout);\ntabLoop();\nfunction tabLoop() {\ntabTimeout = setTimeout(function() {\nvar $next = $('.tabs-list').children('.w--current:first').next();\nif($next.length) {\nif ($(\".menu-button\").hasClass(\"w--open\")) {\ntabLoop();\n}else{\n$next.removeAttr(\"href\").click();\n}\n} else {\nif ($(\".menu-button\").hasClass(\"w--open\")){\ntabLoop();\n}else{\n$('.tab-text-box-kuberno:first').removeAttr(\"href\").click();\n}\n}\n}, 8000); // 8 seconds\n}\n$('.tab-text-box-kuberno').click(function() {\nclearTimeout(tabTimeout);\ntabLoop();\n});\n});\n</script>\n  <script>\n$(document).ready(function() {\n$('#toggle-1').addClass('w--open');\n$('#dropdown-list-1').addClass('w--open');\n$('.dropdown-wrap').on('click',function() {\n $('#toggle-1').removeClass('w--open');\n $('#dropdown-list-1').removeClass('w--open');\n });\n});\n</script>\n  <!--  Load HubSpot Forms Library for EU Region  -->\n  <script src=\"https://hsforms.net\" charset=\"utf-8\"></script>\n  <script>\ndocument.addEventListener(\"DOMContentLoaded\", function() {\n  // Target your Webflow button by its ID\n  var myButton = document.getElementById('hubspot-popup-btn');\n  if (myButton) {\n    myButton.addEventListener('click', function(e) {\n      e.preventDefault(); // Stop the button from reloading the page\n      // Open the form as a popup\n      hbspt.forms.create({\n        region: \"eu1\",\n        portalId: \"145389996\",\n        formId: \"b703b785-389e-46f9-acd5-7e803e123ce0\",\n        popover: true // This creates the popup effect instead of an inline form\n      });\n    });\n  }\n});\n</script>\n  <!--  video examples script  -->\n  <!--  <script>\ndocument.addEventListener(\"DOMContentLoaded\", function() {\n    const settings = {\n        scrollDuration: 16000,\n        scrollInterval: 10,\n        stopOnHover: true,\n    };\n    function initializeSlider(index = \"\") {\n        const indexSuffix = index ? `-${index}` : \"\";\n        const leftSlide = document.querySelector(`[slider=\"left${indexSuffix}\"]`);\n        const rightSlide = document.querySelector(`[slider=\"right${indexSuffix}\"]`);\n        if (!leftSlide && !rightSlide) {\n            console.error(`Не найдены слайдеры с индексом ${index}. Проверьте HTML-код.`);\n            return;\n        }\n        const leftSlides = leftSlide ? leftSlide.querySelectorAll(`[slide=\"duplicate${indexSuffix}\"]`) : [];\n        const rightSlides = rightSlide ? rightSlide.querySelectorAll(`[slide=\"duplicate${indexSuffix}\"]`) : [];\n        // Дублируем слайды для бесшовного эффекта\n        leftSlides.forEach(slide => {\n            leftSlide.appendChild(slide.cloneNode(true));\n            leftSlide.appendChild(slide.cloneNode(true));\n        });\n        rightSlides.forEach(slide => {\n            rightSlide.appendChild(slide.cloneNode(true));\n            rightSlide.appendChild(slide.cloneNode(true));\n        });\n        function getSlideWidth(slides) {\n            const slideStyle = window.getComputedStyle(slides[0]);\n            const slideWidth = slides[0].getBoundingClientRect().width;\n            const gap = parseFloat(slideStyle.gap) || 0;\n            return slideWidth + gap;\n        }\n        const scrollDistanceLeft = leftSlides.length ? getSlideWidth(leftSlides) : 0;\n        const scrollDistanceRight = rightSlides.length ? getSlideWidth(rightSlides) : 0;\n        const scrollStepLeft = scrollDistanceLeft / (settings.scrollDuration / settings.scrollInterval);\n        const scrollStepRight = scrollDistanceRight / (settings.scrollDuration / settings.scrollInterval);\n        let leftScroll = 0;\n        let rightScroll = 0;\n        let leftIntervalId, rightIntervalId;\n        function moveLeftSlides() {\n            if (!leftSlide) return;\n            leftScroll += scrollStepLeft;\n            leftSlide.style.transform = `translateX(-${Math.floor(leftScroll)}px)`;\n            if (leftScroll >= scrollDistanceLeft) {\n                leftScroll = 0;\n                leftSlide.style.transition = 'none';\n                leftSlide.style.transform = 'translateX(0)';\n                setTimeout(() => {\n                    leftSlide.style.transition = '';\n                }, 0);\n            }\n        }\n        function moveRightSlides() {\n            if (!rightSlide) return;\n            rightScroll += scrollStepRight;\n            rightSlide.style.transform = `translateX(${Math.floor(rightScroll)}px)`;\n            if (rightScroll >= scrollDistanceRight) {\n                rightScroll = 0;\n                rightSlide.style.transition = 'none';\n                rightSlide.style.transform = 'translateX(0)';\n                setTimeout(() => {\n                    rightSlide.style.transition = '';\n                }, 0);\n            }\n        }\n        function startLeftAnimation() {\n            if (leftSlide) {\n                leftIntervalId = setInterval(moveLeftSlides, settings.scrollInterval);\n            }\n        }\n        function startRightAnimation() {\n            if (rightSlide) {\n                rightIntervalId = setInterval(moveRightSlides, settings.scrollInterval);\n            }\n        }\n        function stopLeftAnimation() {\n            if (leftSlide) clearInterval(leftIntervalId);\n        }\n        function stopRightAnimation() {\n            if (rightSlide) clearInterval(rightIntervalId);\n        }\n        if (settings.stopOnHover) {\n            if (leftSlide) {\n                leftSlide.addEventListener('mouseenter', stopLeftAnimation);\n                leftSlide.addEventListener('mouseleave', startLeftAnimation);\n            }\n            if (rightSlide) {\n                rightSlide.addEventListener('mouseenter', stopRightAnimation);\n                rightSlide.addEventListener('mouseleave', startRightAnimation);\n            }\n        }\n        startLeftAnimation();\n        startRightAnimation();\n    }\n    // Проверка наличия слайдера без индекса\n    if (document.querySelector('[slider=\"left\"]') || document.querySelector('[slider=\"right\"]')) {\n        initializeSlider();\n    }\n    // Автоматически инициализировать слайдеры с индексами -2, -3 и так далее\n    let index = 2;\n    while (document.querySelector(`[slider=\"left-${index}\"]`) || document.querySelector(`[slider=\"right-${index}\"]`)) {\n        initializeSlider(index);\n        index++;\n    }\n});\n</script>  -->\n  <!--  /end  -->\n  ",
    "bodyStart": "<script>document.body.className=\"body\";</script>"
  }
};
