<script is:inline>
var Webflow = Webflow || [];
Webflow.push(function () {
var tabTimeout;
clearTimeout(tabTimeout);
tabLoop();
function tabLoop() {
tabTimeout = setTimeout(function() {
var $next = $('.tabs-list').children('.w--current:first').next();
if($next.length) {
if ($(".menu-button").hasClass("w--open")) {
tabLoop();
}else{
$next.removeAttr("href").click();
}
} else {
if ($(".menu-button").hasClass("w--open")){
tabLoop();
}else{
$('.tab-text-box-kuberno:first').removeAttr("href").click();
}
}
}, 8000); // 8 seconds
}
$('.tab-text-box-kuberno').click(function() {
clearTimeout(tabTimeout);
tabLoop();
});
});
</script>
