document.addEventListener("DOMContentLoaded", function() {
  // Target your Webflow button by its ID
  var myButton = document.getElementById('hubspot-popup-btn');
  if (myButton) {
    myButton.addEventListener('click', function(e) {
      e.preventDefault(); // Stop the button from reloading the page
      // Open the form as a popup
      hbspt.forms.create({
        region: "eu1",
        portalId: "145389996",
        formId: "b703b785-389e-46f9-acd5-7e803e123ce0",
        popover: true // This creates the popup effect instead of an inline form
      });
    });
  }
});
