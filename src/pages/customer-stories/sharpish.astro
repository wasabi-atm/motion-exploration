            <div class="left-hero max-640 [grid-column-gap:48px] [grid-row-gap:48px] [flex-flow:column] [justify-content:center] [max-width:640px] [display:flex] max-lg:[grid-column-gap:12px] max-lg:[grid-row-gap:12px] max-lg:[text-align:center] max-lg:[order:1] max-lg:[align-items:center] max-lg:[max-width:100%] max-sm:[grid-column-gap:16px] max-sm:[grid-row-gap:16px]">
