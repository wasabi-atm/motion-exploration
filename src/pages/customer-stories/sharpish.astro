                          <div class="h3 mobile-16">Fixed price</div>
                        </div>
                        <div class="flex-8-subscription hide">
                          <div class="ic-text-subscription-2"><img src="/images/cost.svg" loading="lazy" alt="" class="case-study-tab-icon">
                            <div class="text-14-150">Project Cost</div>
                          </div>
                          <div class="h3 mobile-16">$19,000</div>
                        </div>
                        <div class="flex-8-subscription">
                          <div class="ic-text-subscription-2"><img src="/images/time.svg" loading="lazy" alt="" class="case-study-tab-icon">
