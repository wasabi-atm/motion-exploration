      </section>
      <section class="section-process padding-btm-80">
        <div class="line-gradient-2"></div><img src="/images/Frame-1707478761_1.avif" loading="lazy" sizes="(max-width: 3201px) 100vw, 3201px" srcset="/images/Frame-1707478761_1Frame-1707478761.avif 800w, /images/Frame-1707478761_1.avif 3201w" alt="A black and white photo of the moon and stars" class="image-process-2">
