---
<BaseLayout meta={meta}>
<div data-meno-label="Page content" class="body min-h-screen [color:#fff] [background-color:#080610] [overflow-x:hidden]">


<div class="page-wrapper [color:#fff] [overflow-x:hidden]">
    <NavBanner />
    <div id="cards" class="main-wrapper [z-index:0] [color:#fff] [background-color:#080610] [max-width:none] [position:relative] [overflow-x:hidden]">
      <section class="section-hero case-study [background-image:url('../images/Hero_1.avif')] [background-position:0_100%] [background-repeat:no-repeat] [background-size:cover] [background-attachment:scroll] [padding-top:200px] [padding-bottom:120px] max-lg:[background-position:0%] max-lg:[background-size:cover] max-lg:[padding-top:80px] max-sm:[padding-top:80px] max-sm:[padding-bottom:40px]">
        <div id="banner-trigger" class="nav_banner-trigger [pointer-events:none] [border:1px_solid_#0000] [width:100%] [height:240px] [position:absolute] [top:0] [bottom:auto]"></div>
        <div class="w-layout-blockcontainer container-1280 w-container [margin-left:auto] [margin-right:auto] [max-width:1360px] [display:block] [width:100%] [padding-left:40px] [padding-right:40px] [text-decoration:none] max-lg:[max-width:728px] max-lg:[margin-top:0] max-lg:[padding:40px] max-sm:[max-width:none] max-sm:[padding-top:40px] max-landscape:[max-width:none] max-landscape:[margin-top:0] max-landscape:[padding-top:64px] max-landscape:[padding-left:20px] max-landscape:[padding-right:20px]">
          <div class="wrapper-hero flex middle-align [grid-column-gap:40px] [grid-row-gap:40px] [grid-template-rows:auto] [grid-template-columns:1fr_1.25fr] [grid-auto-columns:1fr] [display:flex] [position:relative] [align-items:center] max-lg:[grid-column-gap:20px] max-lg:[grid-row-gap:20px] max-lg:[flex-flow:column-reverse_wrap] max-lg:[justify-content:flex-end] max-lg:[align-items:center] max-lg:[display:flex] max-landscape:[grid-column-gap:20px] max-landscape:[grid-row-gap:20px]">
            <div class="left-hero max-640 [grid-column-gap:48px] [grid-row-gap:48px] [flex-flow:column] [justify-content:center] [max-width:640px] [display:flex] max-lg:[grid-column-gap:12px] max-lg:[grid-row-gap:12px] max-lg:[text-align:center] max-lg:[order:1] max-lg:[align-items:center] max-lg:[max-width:100%] max-sm:[grid-column-gap:16px] max-sm:[grid-row-gap:16px]">
              <div class="gap-4 [grid-column-gap:12px] [grid-row-gap:12px] [flex-flow:column] [display:flex] max-lg:[justify-content:flex-start] max-lg:[align-items:center]">
                <div class="w-layout-hflex flex-block-2 [flex-direction:row] [align-items:flex-start] [display:flex] [grid-column-gap:4px] [grid-row-gap:4px] max-sm:[text-align:center] max-sm:[flex-flow:row] max-sm:[justify-content:flex-start] max-sm:[align-items:center]">
                  <a href="#" class="text-caps [color:#fff9] [letter-spacing:4.2px] [text-transform:uppercase] [font-family:Switzer,_sans-serif] [font-size:14px] [font-weight:400] [line-height:150%] [text-decoration:none] max-landscape:[font-size:12px] max-sm:[font-size:10px]">Customer stories</a>
                  <div class="text-caps [color:#fff9] [letter-spacing:4.2px] [text-transform:uppercase] [font-family:Switzer,_sans-serif] [font-size:14px] [font-weight:400] [line-height:150%] [text-decoration:none] max-landscape:[font-size:12px] max-sm:[font-size:10px]">&gt;</div>
                  <div class="text-caps [color:#fff9] [letter-spacing:4.2px] [text-transform:uppercase] [font-family:Switzer,_sans-serif] [font-size:14px] [font-weight:400] [line-height:150%] [text-decoration:none] max-landscape:[font-size:12px] max-sm:[font-size:10px]">Open Money</div>
                </div>
                <h1 class="h1 [color:#fff] [text-wrap:balance] [margin-top:0] [margin-bottom:0] [padding-right:0] [font-family:Switzer,_sans-serif] [font-size:48px] [font-weight:600] [line-height:120%] max-lg:[font-size:44px] max-landscape:[font-size:38px] max-sm:[font-size:28px] max-sm:[font-weight:600]"><span class="span-pink-2 [box-sizing:border-box] [-webkit-text-fill-color:transparent] [background-image:linear-gradient(90deg,_#ff13bb,_#e225ff_39%,_#5a55ff)] [-webkit-background-clip:text] [background-clip:text]">40+ UI Animations </span>that<br />enhanced Open Money’s website</h1>
