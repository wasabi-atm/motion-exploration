            background: radial-gradient(ellipse 80% 50% at 50% -20%, rgba(120, 119, 198, 0.1), rgba(255, 255, 255, 0));
        }
        #cards:hover > .card::after {
            opacity: 1;
        }
        .card:hover::before {
            opacity: 1;
