media#breadcrumb\"\n      },\n      \"description\": \"Create scroll-stopping social media videos with Motion The Agency. From short-form ads to brand stories, we craft content that connects and converts.\",\n      \"inLanguage\": \"en\",\n      \"isPartOf\": {\n        \"@id\": \"https://www.motiontheagency.com/#website\"\n      },\n      \"mainEntity\": {\n        \"@id\": \"https://www.motiontheagency.com/services/social-media#service\"\n      },\n      \"name\": \"Social Media Video Production Services | Motion The Agency\",\n      \"url\": \"https://www.motiontheagency.com/services/social-media\"\n    },\n    {\n      \"@id\": \"https://www.motiontheagency.com/services/social-media#service\",\n      \"@type\": \"Service\",\n      \"areaServed\": [\n        {\n          \"@type\": \"Country\",\n          \"name\": \"United States\"\n        },\n        {\n          \"@type\": \"Country\",\n          \"name\": \"United Kingdom\"\n        },\n        {\n          \"@type\": \"Country\",\n          \"name\": \"Australia\"\n        }\n      ],\n      \"description\": \"Scroll-stopping social media videos, from short-form ads to brand stories, built to connect and convert.\",\n      \"name\": \"Social Media Video Production\",\n      \"provider\": {\n        \"@id\": \"https://www.motiontheagency.com/#organization\"\n      },\n      \"serviceType\": \"Social Media Video Production\",\n      \"url\": \"https://www.motiontheagency.com/services/social-media\"\n    },\n    {\n      \"@id\": \"https://www.motiontheagency.com/services/social-media#breadcrumb\",\n      \"@type\": \"BreadcrumbList\",\n      \"itemListElement\": [\n        {\n          \"@type\": \"ListItem\",\n          \"item\": \"https://www.motiontheagency.com/\",\n          \"name\": \"Home\",\n          \"position\": 1\n        },\n        {\n          \"@type\": \"ListItem\",\n          \"item\": \"https://www.motiontheagency.com/services\",\n          \"name\": \"Services\",\n          \"position\": 2