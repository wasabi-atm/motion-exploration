ing-video#breadcrumb\"\n      },\n      \"description\": \"Training video production that works. From onboarding to compliance, we create content that informs and engages your team.\",\n      \"inLanguage\": \"en\",\n      \"isPartOf\": {\n        \"@id\": \"https://www.motiontheagency.com/#website\"\n      },\n      \"mainEntity\": {\n        \"@id\": \"https://www.motiontheagency.com/services/training-video#service\"\n      },\n      \"name\": \"Training Video Production Services | Get Your Free Sample\",\n      \"url\": \"https://www.motiontheagency.com/services/training-video\"\n    },\n    {\n      \"@id\": \"https://www.motiontheagency.com/services/training-video#service\",\n      \"@type\": \"Service\",\n      \"areaServed\": [\n        {\n          \"@type\": \"Country\",\n          \"name\": \"United States\"\n        },\n        {\n          \"@type\": \"Country\",\n          \"name\": \"United Kingdom\"\n        },\n        {\n          \"@type\": \"Country\",\n          \"name\": \"Australia\"\n        }\n      ],\n      \"description\": \"Training video production covering onboarding through compliance, creating content that informs and engages your team.\",\n      \"name\": \"Training Video Production\",\n      \"provider\": {\n        \"@id\": \"https://www.motiontheagency.com/#organization\"\n      },\n      \"serviceType\": \"Training Video Production\",\n      \"url\": \"https://www.motiontheagency.com/services/training-video\"\n    },\n    {\n      \"@id\": \"https://www.motiontheagency.com/services/training-video#breadcrumb\",\n      \"@type\": \"BreadcrumbList\",\n      \"itemListElement\": [\n        {\n          \"@type\": \"ListItem\",\n          \"item\": \"https://www.motiontheagency.com/\",\n          \"name\": \"Home\",\n          \"position\": 1\n        },\n        {\n          \"@type\": \"ListItem\",\n          \"item\": \"https://www.motiontheagency.com/services\",\n          \"name\": \"Services\",\n          \"position\": 2\n        },\n        {\n          \"@type\": \"ListItem\",\n          \"item\": \"https://www.motiontheagency.com/services/training-video\",\n          \"name\": \"Training Video\",\n          \"position\": 3\n        }\n      ]\n    }\n  ]\n}\n</script>\n  \n<!--  [Attributes by Finsweet] CMS Slider  -->\n<script async=\"\" src=\"https://cdn.jsdelivr.net/npm/@finsweet/attributes-cmsslider@1/cmsslider.js\"></script>\n<!--  Slick Slider CSS  -->\n<link rel=\"stylesheet\" type=\"text/css\" href=\"//cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css\">\n<style>\n/*Slick Slider Customizations*/\n.slick-list {\n\t\tdisplay: flex;\n    overflow: visible;\n    width: 100%;\n}\n.slick-track {\n\t\tdisplay: flex;\n}\n</style>\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@graph\": [\n    {\n      \"@type\": \"Product\",\n      \"name\": \"Training Video Production Services\",\n      \"url\": \"https://motiontheagency.com/services/training-video-production/\",\n      \"description\": \"Training video production that drives results. From onboarding to compliance, we create videos that inform, engage, and inspire your team. Explore our services now.\",\n      \"brand\": {\n        \"@type\": \"Brand\",\n        \"name\": \"Motion The Agency\"\n      },\n      \"review\": {\n        \"@type\": \"Review\",\n        \"reviewRating\": {\n          \"@type\": \"Rating\",\n          \"ratingValue\": \"5\",\n          \"bestRating\": \"5\"\n        },\n        \"author\": {\n          \"@type\": \"Organization\",\n          \"name\": \"Clutch\",\n          \"url\": \"https://clutch.co/profile/motion-agency-0\"\n        }\n      }\n    },\n    {\n      \"@type\": \"FAQPage\",\n      \"mainEntity\": [\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What types of training videos do you produce?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"We produce a wide range of corporate training videos, including:\\n\\n- Onboarding and orientation videos\\n- Compliance training videos\\n- Product and service knowledge videos\\n- Technical skills training videos\\n- Cybersecurity awareness videos\\n- Health and safety training videos\\n\\nOur animated videos are tailored to your specific needs and designed to engage and educate your workforce effectively.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"How long does it take to produce a training video?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"The production time can vary depending on the complexity and length of the video. We follow a structured process that includes content collection, creative alignment, and sample creation before moving into full production. For a more accurate timeline, we recommend discussing your specific project requirements with our team.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"Can you update existing training videos?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Yes, we offer flexible solutions for updating existing training videos. Unlike traditional videography, our animated content allows for seamless updates. This makes it easy to keep your training courses up-to-date without significant costs, ensuring your content remains relevant and accurate.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"Do you offer voice-over services in multiple languages?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"While not explicitly mentioned in the provided content, it's common for professional video production services to offer multi-language voice-over options. We recommend contacting our team directly to discuss specific language requirements for your project.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"Can you integrate the videos with our existing Learning Management System (LMS)?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Yes, our training videos are designed to work seamlessly with Learning Management Systems (LMS) or Virtual Learning Environments (VLE). This integration enhances learning outcomes and knowledge retention, creating more effective training experiences for your team.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What file formats do you deliver the final videos in?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"We deliver our videos in industry-standard formats that are compatible with most platforms and devices. For specific format requirements, please discuss your needs with our team during the project planning phase.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"Do you offer any analytics or tracking features with the videos?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Yes, we provide tools to track engagement and assess comprehension. These analytics offer actionable insights into the impact of your training videos, allowing for continuous improvement and helping you measure the return on your educational investment.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"How do you handle confidential or sensitive information in training videos?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"We take the security and confidentiality of your information very seriously. Our process includes:\\n\\n- Strict confidentiality measures\\n- Limited access controls\\n- IP protection\\n- Clear ownership agreements\\n- Secure file transfer\\n- Data destruction options\\n- Non-disclosure agreements for all team members\\n\\nWe ensure that your sensitive content is safeguarded throughout the entire production process.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"Can we reuse the animated characters or elements in future videos?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Yes, one of the benefits of choosing animated videos for training is the ability to reuse and repurpose elements. This approach allows for scalable training solutions, making it easy to update content or add to existing modules as your business grows and training needs evolve. It also helps maintain consistency in your brand and visual style across multiple training videos.\"\n          }\n        }\n      ]\n    }\n  ]\n}\n</script>\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"VideoObject\",\n  \"name\": \"Airesolve Training Video — Motion The Agency\",\n  \"description\": \"Training video produced by Motion The Agency for Airesolve.\",\n  \"thumbnailUrl\": \"../videos/Airesolve-poster-00001.jpg\",\n  \"uploadDate\": \"2024-12-06T12:31:41+00:00\",\n  \"duration\": \"PT10S\",\n  \"contentUrl\": \"../videos/Airesolve-transcode.mp4\",\n  \"publisher\": {\n    \"@type\": \"Organization\",\n    \"name\": \"Motion The Agency\",\n    \"logo\": {\n      \"@type\": \"ImageObject\",\n      \"url\": \"https://cdn.prod.website-files.com/66ebfb6ec8f20d5eda50eb34/6762c1dea24d4f98491f457f_Logo.png\"\n    }\n  }\n}\n</script>\n  <meta name=\"twitter:title\" content=\"Training Video Production Services | Get Your Free Sample\">\n<meta name=\"twitter:description\" content=\"Training video production that works. From onboarding to compliance, we create content that informs and engages your team.\">\n<meta name=\"twitter:image\" content=\"https://cdn.prod.website-files.com/66ebfb6ec8f20d5eda50eb34/670cc171a0c8c36348181481_UI%20Animation%20Thumbnail.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">",
    "bodyEnd": "\n<!--  Slick Slider JS  -->\n  <script type=\"text/javascript\" src=\"https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js\"></script>\n  <!--  Card Slider Config  -->\n  <script>\n    $(document).ready(function() {\n        //-------- Filter functionality ----------\n        // Add class name of category slug to each slider item\n        $('.card-slider_item').addClass(function() {\n            return $(this).find('.card-category_slug').text() //class of element hidden in slider collection with category slug\n        });\n        // When you click a dropdown link, filter the slider\n        $(\".dropdown-link\").click(function() {\n            if ($(this).hasClass(\"cc-selected\")) { //if the dropdown link is already selected, unselect and unfilter the slider\n                $(\"#cms-slider\").slick('slickUnfilter');\n                $(this).removeClass(\"cc-selected\");\n            } else { //if the dropdown link isn't selected, add selected class and filter the slider\n                $(\".dropdown-link\").removeClass(\"cc-selected\");\n                $(this).addClass(\"cc-selected\");\n                var filter = $(this).find('.dropdown-link_slug').text(); //class of element hidden in dropdown link with category slug\n                var filterClass = '.' + filter; //add '.' before slug name to associate it as a class\n                $(\"#cms-slider\").slick('slickUnfilter'); //clear previous filter on slider\n                $(\"#cms-slider\").slick('slickFilter', filterClass); //filter the slider by the selected dropdown link's slug\n            }\n        });\n        //-------- Configure slider ----------\n        $('#cms-slider').slick({\n            arrows: false,\n            infinite: false,\n            autoplay: false,\n            autoplaySpeed: 8000,\n            speed: 300,\n            slidesToShow: 3,\n            slidesToScroll: 1,\n            responsive: [{\n                    breakpoint: 1024,\n                    settings: {\n                        slidesToShow: 2\n                    }\n                },\n                {\n                    breakpoint: 768,\n                    settings: {\n                        slidesToShow: 1\n                    }\n                }\n            ]\n        });\n        //--------- Set custom nav ---------\n        $('#cms-slider-right').click(function() {\n            $('#cms-slider').slick('slickNext');\n        });\n        $('#cms-slider-left').click(function() {\n            $('#cms-slider').slick('slickPrev');\n        });\n    });\n</script>\n  ",
    "bodyStart": "<script>document.body.className=\"body\";</script>"
  }
};
