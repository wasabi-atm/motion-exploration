            <div class="gap-76 [grid-column-gap:70px] [grid-row-gap:70px] [flex-flow:column] [width:100%] [display:flex] max-landscape:[grid-column-gap:60px] max-landscape:[grid-row-gap:60px]">
              <div class="wrapper-hero [grid-column-gap:40px] [grid-row-gap:40px] [grid-template-rows:auto] [grid-template-columns:1fr_1.25fr] [grid-auto-columns:1fr] [display:grid] max-lg:[grid-column-gap:20px] max-lg:[grid-row-gap:20px] max-lg:[flex-flow:column-reverse_wrap] max-lg:[justify-content:flex-end] max-lg:[align-items:center] max-lg:[display:flex] max-landscape:[grid-column-gap:20px] max-landscape:[grid-row-gap:20px]">
