  "ogDescription": "Elevate your brand identity with design that connects. From visuals to full systems, we build brands that feel consistent, bold, and unforgettable.",
  "ogImage": "https://cdn.prod.website-files.com/66ebfb6ec8f20d5eda50eb34/670cc171a0c8c36348181481_UI%20Animation%20Thumbnail.png",
  "ogType": "website",
  "customCode": {
    "head": "\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@graph\": [\n    {\n      \"@id\": \"https://www.motiontheagency.com/#organization\",\n      \"@type\": \"Organization\",\n      \"address\": {\n        \"@type\": \"PostalAddress\",\n        \"addressCountry\": \"GB\",\n        \"addressLocality\": \"London\",\n        \"postalCode\": \"EC2N 4AH\",\n        \"streetAddress\": \"42-44 Bishopsgate\"\n      },\n      \"alternateName\": \"Motion Agency\",\n      \"email\": \"hello@motiontheagency.com\",\n      \"foundingDate\": \"2019\",\n      \"logo\": {\n        \"@type\": \"ImageObject\",\n        \"url\": \"https://cdn.prod.website-files.com/66ebfb6ec8f20d5eda50eb34/6707b5de43efcae5a6bbe759_Motion%20logo%20-%20square.png\"\n      },\n      \"name\": \"Motion The Agency\",\n      \"numberOfEmployees\": {\n        \"@type\": \"QuantitativeValue\",\n        \"value\": 25\n      },\n      \"sameAs\": [\n        \"https://uk.linkedin.com/company/motion-the-agency\",\n        \"https://www.youtube.com/@motiontheagency\",\n        \"https://www.instagram.com/motion.theagency/\",\n        \"https://clutch.co/profile/motion-agency\",\n        \"https://www.designrush.com/agency/profile/motion-the-agency\",\n        \"https://www.g2.com/products/motion-the-agency/reviews\"\n      ],\n      \"telephone\": \"+44 20 3984 7787\",\n      \"url\": \"https://www.motiontheagency.com/\"\n    },\n    {\n      \"@id\": \"https://www.motiontheagency.com/#website\",\n      \"@type\": \"WebSite\",\n      \"inLanguage\": \"en\",\n      \"name\": \"Motion The Agency\",\n      \"publisher\": {\n        \"@id\": \"https://www.motiontheagency.com/#organization\"\n      },\n      \"url\": \"https://www.motiontheagency.com/\"\n    },\n    {\n      \"@id\": \"https://www.motiontheagency.com/services/brand-design#webpage\",\n      \"@type\": \"WebPage\",\n      \"breadcrumb\": {\n        \"@id\": \"https://www.motiontheagency.com/services/brand-design#breadcrumb\"\n      },\n      \"description\": \"Elevate your brand identity with design that connects. From visuals to full systems, we build brands that feel consistent, bold, and unforgettable.\",\n      \"inLanguage\": \"en\",\n      \"isPartOf\": {\n        \"@id\": \"https://www.motiontheagency.com/#website\"\n      },\n      \"mainEntity\": {\n        \"@id\": \"https://www.motiontheagency.com/services/brand-design#service\"\n      },\n      \"name\": \"Professional Brand Identity & Design Services for Business\",\n      \"url\": \"https://www.motiontheagency.com/services/brand-design\"\n    },\n    {\n      \"@id\": \"https://www.motiontheagency.com/services/brand-design#service\",\n      \"@type\": \"Service\",\n      \"areaServed\": [\n        {\n          \"@type\": \"Country\",\n          \"name\": \"United States\"\n        },\n        {\n          \"@type\": \"Country\",\n          \"name\": \"United Kingdom\"\n        },\n        {\n          \"@type\": \"Country\",\n          \"name\": \"Australia\"\n        }\n      ],\n      \"description\": \"Brand identity design, from individual visuals to full systems, built to feel consistent and distinctive.\",\n      \"name\": \"Brand Identity Design\",\n      \"provider\": {\n        \"@id\": \"https://www.motiontheagency.com/#organization\"\n      },\n      \"serviceType\": \"Brand Identity Design\",\n      \"url\": \"https://www.motiontheagency.com/services/brand-design\"\n    },\n    {\n      \"@id\": \"https://www.motiontheagency.com/services/brand-design#breadcrumb\",\n      \"@type\": \"BreadcrumbList\",\n      \"itemListElement\": [\n        {\n          \"@type\": \"ListItem\",\n          \"item\": \"https://www.motiontheagency.com/\",\n          \"name\": \"Home\",\n          \"position\": 1\n        },\n        {\n          \"@type\": \"ListItem\",\n          \"item\": \"https://www.motiontheagency.com/services\",\n          \"name\": \"Services\",\n          \"position\": 2\n        },\n        {\n          \"@type\": \"ListItem\",\n          \"item\": \"https://www.motiontheagency.com/services/brand-design\",\n          \"name\": \"Brand Design\",\n          \"position\": 3\n        }\n      ]\n    }\n  ]\n}\n</script>\n  \n<!--  [Attributes by Finsweet] CMS Slider  -->\n<script async=\"\" src=\"https://cdn.jsdelivr.net/npm/@finsweet/attributes-cmsslider@1/cmsslider.js\"></script>\n<!--  Slick Slider CSS  -->\n<link rel=\"stylesheet\" type=\"text/css\" href=\"//cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css\">\n<style>\n/*Slick Slider Customizations*/\n.slick-list {\n\t\tdisplay: flex;\n    overflow: visible;\n    width: 100%;\n}\n.slick-track {\n\t\tdisplay: flex;\n}\n</style>\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@graph\": [\n    {\n      \"@type\": \"Product\",\n      \"name\": \"Professional Brand Identity & Design Services\",\n      \"url\": \"https://motiontheagency.com/services/brand-identity/\",\n      \"description\": \"Move your brand with our comprehensive brand identity and design system services. Streamline your digital asset management. Book a free consultation.\",\n      \"brand\": {\n        \"@type\": \"Brand\",\n        \"name\": \"Motion The Agency\"\n      },\n      \"review\": {\n        \"@type\": \"Review\",\n        \"reviewRating\": {\n          \"@type\": \"Rating\",\n          \"ratingValue\": \"5\",\n          \"bestRating\": \"5\"\n        },\n        \"author\": {\n          \"@type\": \"Organization\",\n          \"name\": \"Clutch\",\n          \"url\": \"https://clutch.co/profile/motion-agency-0\"\n        }\n      }\n    },\n    {\n      \"@type\": \"FAQPage\",\n      \"mainEntity\": [\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What makes your brand design process unique?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Our process emphasizes thorough research and concept exploration. We believe in the power of references, even from different industries, to inspire unique designs that resonate with your target audience. Our approach involves extensive testing and iteration, allowing for quick feedback and concept evolution.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"How do you handle the challenges of articulating brand style?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"We understand that language often limits our ability to convey abstract ideas. That's why our team of designers is skilled in researching and articulating the design style best suited to your business, bridging the gap between concept and visual representation.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"Why should we focus on comprehensive brand identity rather than just a logo?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"A thorough and well-organized set of brand assets streamlines creativity across your business. It facilitates easier outsourcing of video production, web design, and content creation without lengthy back-and-forth communication. Our approach provides you with a robust, easy-to-use set of rules and assets that work cohesively across all aspects of your business.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What does a modern brand identity package include?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Our modern brand identity packages include ready-to-use assets for video production (motion graphics), graphics suitable for UI and graphic designers, color palettes, fonts, and logos in various accessible formats, and editable templates for quick customization. We offer different levels of brand identity packages to suit various needs and budgets.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"How does your service differ from traditional brand design agencies?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Unlike agencies that focus solely on graphic design, we create contemporary brand identity packages suitable for video, events, product development, and more. Our service often involves enhancing existing branding work, ensuring it's suitable for all aspects of your business and marketing efforts.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"Can you work with our existing brand elements?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Absolutely. While we can provide stand-alone brand conception, it's more common for us to enhance and build upon your existing work. We can subtly improve your brand identity and ensure it's ready for various applications, from updating sales collateral to creating brand motion graphics and applying branding to UI, web, and video.\"\n          }\n        }\n      ]\n    }\n  ]\n}\n</script>\n  <meta name=\"twitter:title\" content=\"Professional Brand Identity &amp; Design Services for Business\">\n<meta name=\"twitter:description\" content=\"Elevate your brand identity with design that connects. From visuals to full systems, we build brands that feel consistent, bold, and unforgettable.\">\n<meta name=\"twitter:image\" content=\"https://cdn.prod.website-files.com/66ebfb6ec8f20d5eda50eb34/670cc171a0c8c36348181481_UI%20Animation%20Thumbnail.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">",
    "bodyEnd": "\n<!--  Slick Slider JS  -->\n  <script type=\"text/javascript\" src=\"https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js\"></script>\n  <!--  Card Slider Config  -->\n  <script>\n    $(document).ready(function() {\n        //-------- Filter functionality ----------\n        // Add class name of category slug to each slider item\n        $('.card-slider_item').addClass(function() {\n            return $(this).find('.card-category_slug').text() //class of element hidden in slider collection with category slug\n        });\n        // When you click a dropdown link, filter the slider\n        $(\".dropdown-link\").click(function() {\n            if ($(this).hasClass(\"cc-selected\")) { //if the dropdown link is already selected, unselect and unfilter the slider\n                $(\"#cms-slider\").slick('slickUnfilter');\n                $(this).removeClass(\"cc-selected\");\n            } else { //if the dropdown link isn't selected, add selected class and filter the slider\n                $(\".dropdown-link\").removeClass(\"cc-selected\");\n                $(this).addClass(\"cc-selected\");\n                var filter = $(this).find('.dropdown-link_slug').text(); //class of element hidden in dropdown link with category slug\n                var filterClass = '.' + filter; //add '.' before slug name to associate it as a class\n                $(\"#cms-slider\").slick('slickUnfilter'); //clear previous filter on slider\n                $(\"#cms-slider\").slick('slickFilter', filterClass); //filter the slider by the selected dropdown link's slug\n            }\n        });\n        //-------- Configure slider ----------\n        $('#cms-slider').slick({\n            arrows: false,\n            infinite: false,\n            autoplay: false,\n            autoplaySpeed: 8000,\n            speed: 300,\n            slidesToShow: 3,\n            slidesToScroll: 1,\n            responsive: [{\n                    breakpoint: 1024,\n                    settings: {\n                        slidesToShow: 2\n                    }\n                },\n                {\n                    breakpoint: 768,\n                    settings: {\n                        slidesToShow: 1\n                    }\n                }\n            ]\n        });\n        //--------- Set custom nav ---------\n        $('#cms-slider-right').click(function() {\n            $('#cms-slider').slick('slickNext');\n        });\n        $('#cms-slider-left').click(function() {\n            $('#cms-slider').slick('slickPrev');\n        });\n    });\n</script>\n  ",
    "bodyStart": "<script>document.body.className=\"body\";</script>"
  }
};
