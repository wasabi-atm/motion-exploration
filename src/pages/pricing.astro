---
import '../styles/theme.css';
import { BaseLayout, Embed } from 'meno-astro/components';
import NavBanner from '../components/NavBanner.astro';
import Footer from '../components/Footer.astro';

const meta = {
  "title": "Video Production Pricing Plan | Motion The Agency",
  "description": "Explore transparent video production pricing from Motion The Agency, with fixed-price projects, subscriptions and Creative Credits for every level of demand.",
  "htmlAttributes": {
    "data-wf-page": "6a4bd9b8c20edea2d5c796fe",
    "data-wf-site": "66ebfb6ec8f20d5eda50eb34"
  },
  "ogTitle": "Video Production Pricing Plan | Motion The Agency",
  "ogDescription": "Explore transparent video production pricing from Motion The Agency, with fixed-price projects, subscriptions and Creative Credits for every level of demand.",
  "ogType": "website",
  "customCode": {
    "head": "\n<style>\n  /* ─── QUIZ ─── */\n  [data-quiz]:not([data-quiz-ready]) [data-quiz-step]:not(:first-of-type){ display:none !important; }\n  [data-quiz]:not([data-quiz-ready]) [data-quiz-result]{ display:none !important; }\n  [hidden]{ display:none !important; }\n  [data-quiz-progress]{ transition: background-color .25s ease, opacity .25s ease; }\n  [data-quiz-progress].is-active{ background-color:#581DE3; opacity:1; }\n  [data-quiz][data-quiz-result-value] [data-quiz-progress]{\n    display: none !important;\n  }\n  @keyframes quizShake { 0%,100%{transform:translateX(0)} 25%{transform:translateX(-5px)} 75%{transform:translateX(5px)} }\n  [data-quiz-step].is-invalid{ animation: quizShake .35s ease; }\n  [data-quiz-option]{\n    cursor: pointer;\n    transition: border-color .2s ease, background-color .2s ease, box-shadow .2s ease;\n  }\n  [data-quiz-option].is-selected{\n  border: 1px solid #581DE3 !important;\n  background: linear-gradient(90deg, rgba(15, 10, 45, 0.95), rgba(75, 40, 155, 0.55), rgba(15, 10, 45, 0.95)) !important;\n  box-shadow: 0 0 0 1px rgba(135,100,255,0.6), 0 0 18px rgba(135,100,255,0.25);\n}\n  [data-quiz-option] .check-icon{\n    opacity: .35;\n    transition: opacity .2s ease, filter .2s ease;\n  }\n  [data-quiz-option].is-selected .check-icon{\n    opacity: 1;\n    filter: drop-shadow(0 0 5px rgba(135,100,255,0.7));\n  }\n  [data-quiz-option]:not(.is-selected):hover{\n    border-color: rgba(135,100,255,0.4);\n  }\n</style>\n<style>\n  /* ─── TESTIMONIAL ─── */\n  [data-testi]:not([data-testi-ready]) [data-testi-slide]:not(:first-of-type){ display:none !important; }\n  [data-testi-slide][hidden]{ display:none !important; }\n  [data-testi-avatar]{ display:none !important; }\n  /* Slide content animations */\n  @keyframes testiFade     { from{ opacity:0; transform:translateY(6px);  } to{ opacity:1; transform:none; } }\n  @keyframes testiFadeUp   { from{ opacity:0; transform:translateY(24px); } to{ opacity:1; transform:none; } }\n  @keyframes testiFadeDown { from{ opacity:0; transform:translateY(-24px);} to{ opacity:1; transform:none; } }\n  [data-testi-slide]:not([hidden]):not(.slide-up):not(.slide-down){ animation: testiFade .35s ease; }\n  [data-testi-slide].slide-up:not([hidden])  { animation: testiFadeUp   .4s cubic-bezier(.4,0,.2,1); }\n  [data-testi-slide].slide-down:not([hidden]){ animation: testiFadeDown .4s cubic-bezier(.4,0,.2,1); }\n  [data-testi-prev], [data-testi-next]{ cursor:pointer; user-select:none; }\n  [data-testi-prev].is-disabled, [data-testi-next].is-disabled{ opacity:.3; pointer-events:none; }\n  [data-testi-rail] img{ transition: opacity .3s ease; }\n  .testi-cs-title{\n    display: -webkit-box;\n    -webkit-line-clamp: 2;\n    -webkit-box-orient: vertical;\n    overflow: hidden;\n  }\n  .testi-brand-logo{\n    background-repeat: no-repeat;\n    background-size: contain;\n    background-position: left center;\n  }\n</style>\n  <meta name=\"twitter:title\" content=\"Video Production Pricing Plan | Motion The Agency\">\n<meta name=\"twitter:description\" content=\"Explore transparent video production pricing from Motion The Agency, with fixed-price projects, subscriptions and Creative Credits for every level of demand.\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">",
    "bodyEnd": "\n<!--  ═══════════════════════ QUIZ ═══════════════════════  -->\n  <script>\n(function () {\n  'use strict';\n  var CONFIG = {\n    // Q1 slider: budget (£k) → skor per plan\n    sliderScore: function (v) {\n      if (v >= 50) return { subscription: 3 };\n      if (v >= 20) return { creativecredits: 2, subscription: 2 };\n      if (v >= 8)  return { creativecredits: 3, fixedprice: 1 };\n      if (v >= 3)  return { fixedprice: 2, creativecredits: 1 };\n      return { fixedprice: 3 };                       // 1–3\n    },\n    priority: ['subscription', 'creativecredits', 'fixedprice'], // tie-break order\n    defaultResult: 'subscription',\n    requireSelection: true,\n    selectedClass: 'is-selected'\n  };\n  var norm = function (s) { return (s || '').toLowerCase().replace(/\\s+/g, ''); };\n  var root = document.querySelector('[data-quiz]');\n  if (!root) return;\n  var steps = [].slice.call(root.querySelectorAll('[data-quiz-step]'));\n  var segments = [].slice.call(root.querySelectorAll('[data-quiz-progress]'));\n  var resultStep = null;\n  steps.forEach(function (s) { if (s.querySelector('[data-quiz-result]')) resultStep = s; });\n  var resultIndex = resultStep ? steps.indexOf(resultStep) : -1;\n  var resultBlocks = resultStep\n    ? [].slice.call(resultStep.querySelectorAll('[data-quiz-result]')) : [];\n  var questionCount = resultIndex >= 0 ? resultIndex : steps.length;\n  var current = 0;\n  function hide(el){ if (el){ el.setAttribute('hidden',''); el.style.display = 'none'; } }\n  function show(el){ if (el){ el.removeAttribute('hidden'); el.style.display = ''; } }\n  function slider(step){ return step.querySelector('input[type=\"range\"]'); }\n  function hasOptions(step){ return !!step.querySelector('[data-quiz-option]'); }\n  function selected(step){ return step.querySelector('[data-quiz-option].' + CONFIG.selectedClass); }\n  // --- Scoring helpers ---\n  function parseScore(str){                 // \"subscription:2,fixedprice:1\" → {subscription:2, fixedprice:1}\n    var out = {};\n    (str || '').split(',').forEach(function (pair){\n      var kv = pair.split(':');\n      var plan = norm(kv[0]);\n      var pts  = parseInt(kv[1], 10);\n      if (plan && !isNaN(pts)) out[plan] = (out[plan] || 0) + pts;\n    });\n    return out;\n  }\n  function addScores(tally, scores){\n    Object.keys(scores).forEach(function (k){ tally[k] = (tally[k] || 0) + scores[k]; });\n  }\n  function updateProgress(){\n    var activeUpTo = (current >= resultIndex && resultIndex >= 0)\n      ? questionCount - 1\n      : current;\n    segments.forEach(function (seg, i){ seg.classList.toggle('is-active', i <= activeUpTo); });\n  }\n  function showStep(i){\n    current = Math.max(0, Math.min(i, steps.length - 1));\n    steps.forEach(function (step, idx){ idx === current ? show(step) : hide(step); });\n    updateProgress();\n  }\n  function validCurrent(){\n    var step = steps[current];\n    if (CONFIG.requireSelection && hasOptions(step) && !selected(step)){\n      step.classList.add('is-invalid');\n      setTimeout(function(){ step.classList.remove('is-invalid'); }, 500);\n      return false;\n    }\n    return true;\n  }\n  function computeResult(){\n    var tally = {};\n    steps.forEach(function (step, idx){\n      if (idx === resultIndex) return;\n      var s = slider(step);\n      if (s){ addScores(tally, CONFIG.sliderScore(parseInt(s.value, 10))); return; }\n      var opt = selected(step);\n      if (opt) addScores(tally, parseScore(opt.getAttribute('data-score')));\n    });\n    // Pemenang; tie-break pakai urutan CONFIG.priority\n    var order = CONFIG.priority.slice();\n    Object.keys(tally).forEach(function (k){ if (order.map(norm).indexOf(k) === -1) order.push(k); });\n    var winner = CONFIG.defaultResult, best = -Infinity;\n    order.forEach(function (p){ var c = tally[norm(p)] || 0; if (c > best){ best = c; winner = p; } });\n    return winner;\n  }\n  function revealWinner(winner){\n    resultBlocks.forEach(function (b){\n      norm(b.getAttribute('data-quiz-result')) === norm(winner) ? show(b) : hide(b);\n    });\n  }\n  function goResult(){\n    var winner = computeResult();\n    showStep(resultIndex);\n    revealWinner(winner);\n    root.setAttribute('data-quiz-result-value', winner);\n  }\n  function restart(){\n    steps.forEach(function (step){\n      [].forEach.call(step.querySelectorAll('[data-quiz-option].' + CONFIG.selectedClass),\n        function (o){ o.classList.remove(CONFIG.selectedClass); });\n      var s = slider(step);\n      if (s) s.value = s.defaultValue;\n    });\n    resultBlocks.forEach(hide);\n    root.removeAttribute('data-quiz-result-value');\n    showStep(0);\n  }\n  root.addEventListener('click', function (e){\n    var opt = e.target.closest('[data-quiz-option]');\n    if (opt){\n      var step = opt.closest('[data-quiz-step]');\n      [].forEach.call(step.querySelectorAll('[data-quiz-option]'),\n        function (s){ s.classList.remove(CONFIG.selectedClass); });\n      opt.classList.add(CONFIG.selectedClass);\n      return;\n    }\n    if (e.target.closest('[data-quiz-next]')){\n      e.preventDefault();\n      if (!validCurrent()) return;\n      var next = current + 1;\n      (resultIndex >= 0 && next === resultIndex) ? goResult() : showStep(next);\n      return;\n    }\n    if (e.target.closest('[data-quiz-prev]')){\n      e.preventDefault();\n      showStep(current - 1);\n      return;\n    }\n    if (e.target.closest('[data-quiz-restart]')){\n      e.preventDefault();\n      restart();\n    }\n  });\n  steps.forEach(function (step, i){ if (i !== 0) hide(step); });\n  resultBlocks.forEach(hide);\n  root.setAttribute('data-quiz-ready','');\n  showStep(0);\n})();\n</script>\n  <!--  ═══════════════════════ TESTIMONIAL ═══════════════════════  -->\n  <script>\n(function () {\n  'use strict';\n  var CONFIG = {\n    loop: false,\n    autoplay: false,\n    autoplayDelay: 6000,\n    pauseOnHover: true\n  };\n  var ANIM_MS = 400;\n  var isAnimating = false;\n  var root = document.querySelector('[data-testi]');\n  if (!root) return;\n  var slides = [].slice.call(root.querySelectorAll('[data-testi-slide]'));\n  if (!slides.length) return;\n  var railPrev = root.querySelector('[data-testi-rail=\"prev\"]');\n  var railCurr = root.querySelector('[data-testi-rail=\"current\"]');\n  var railNext = root.querySelector('[data-testi-rail=\"next\"]');\n  var btnPrev  = root.querySelector('[data-testi-prev]');\n  var btnNext  = root.querySelector('[data-testi-next]');\n  var N = slides.length;\n  var index = 0;\n  var timer = null;\n  function avatarSrc(i){\n    if (i == null || !slides[i]) return '';\n    var el = slides[i].querySelector('[data-testi-avatar]');\n    if (!el) return '';\n    var src = el.currentSrc || el.src || el.getAttribute('src') || '';\n    if (src && src.indexOf('placeholder') === -1) return src;\n    var bg = el.style.backgroundImage || '';\n    var match = bg.match(/url\\([\"']?(.*?)[\"']?\\)/);\n    if (match && match[1]) return match[1];\n    return '';\n  }\n  function setSlot(slot, i){\n    if (!slot) return;\n    var url = avatarSrc(i);\n    var img = slot.querySelector('img');\n    if (img){\n      if (url){ img.src = url; slot.style.visibility = ''; }\n      else { slot.style.visibility = 'hidden'; }\n    } else {\n      if (url){ slot.style.backgroundImage = 'url(\"' + url + '\")'; slot.style.visibility = ''; }\n      else { slot.style.visibility = 'hidden'; }\n    }\n  }\n  function neighbor(i, dir){\n    var j = i + dir;\n    if (j < 0)  return CONFIG.loop ? N - 1 : null;\n    if (j >= N) return CONFIG.loop ? 0 : null;\n    return j;\n  }\n  function render(slideDir){\n    slides.forEach(function (s, i){\n      s.classList.remove('slide-up', 'slide-down');\n      if (i === index){\n        s.removeAttribute('hidden');\n        if (slideDir) s.classList.add(slideDir > 0 ? 'slide-up' : 'slide-down');\n      } else {\n        s.setAttribute('hidden','');\n      }\n    });\n    setSlot(railCurr, index);\n    setSlot(railPrev, neighbor(index, -1));\n    setSlot(railNext, neighbor(index, 1));\n    if (btnPrev) btnPrev.classList.toggle('is-disabled', !CONFIG.loop && index === 0);\n    if (btnNext) btnNext.classList.toggle('is-disabled', !CONFIG.loop && index === N - 1);\n    root.setAttribute('data-testi-index', index);\n  }\n  function go(dir){\n    if (isAnimating) return;\n    var j = neighbor(index, dir);\n    if (j == null) return;\n    isAnimating = true;\n    var slots = [railPrev, railCurr, railNext].filter(Boolean);\n    var axis  = window.innerWidth <= 479 ? 'X' : 'Y';   // mobile horizontal, desktop vertical\n    var shift = dir > 0 ? -70 : 70;\n    var ease  = 'cubic-bezier(.4,0,.2,1)';\n    var tOut  = Math.round(ANIM_MS * 0.75);\n    var tFade = Math.round(ANIM_MS * 0.5);\n    /* Phase 1 — push current avatars out */\n    slots.forEach(function (s){\n      s.style.transition = 'transform ' + tOut + 'ms ' + ease + ', opacity ' + tFade + 'ms ease';\n      s.style.transform  = 'translate' + axis + '(' + shift + 'px)';\n      s.style.opacity    = '0';\n    });\n    setTimeout(function (){\n      /* Update index + content */\n      index = j;\n      render(dir);\n      /* Position avatars on opposite side (no transition) */\n      slots.forEach(function (s){\n        s.style.transition = 'none';\n        s.style.transform  = 'translate' + axis + '(' + (-shift) + 'px)';\n        s.style.opacity    = '0';\n      });\n      /* Force reflow */\n      void root.offsetWidth;\n      /* Phase 2 — push new avatars in */\n      slots.forEach(function (s){\n        s.style.transition = 'transform ' + tOut + 'ms ' + ease + ', opacity ' + tFade + 'ms ease';\n        s.style.transform  = 'translate' + axis + '(0)';\n        s.style.opacity    = '1';\n      });\n      setTimeout(function (){\n        slots.forEach(function (s){\n          s.style.transition = '';\n          s.style.transform  = '';\n          s.style.opacity    = '';\n        });\n        isAnimating = false;\n      }, ANIM_MS);\n    }, tOut);\n  }\n  function startAuto(){\n    if (!CONFIG.autoplay || N < 2) return;\n    stopAuto();\n    timer = setInterval(function (){ go(1); }, CONFIG.autoplayDelay);\n  }\n  function stopAuto(){ if (timer){ clearInterval(timer); timer = null; } }\n  if (btnPrev) btnPrev.addEventListener('click', function (e){ e.preventDefault(); go(-1); });\n  if (btnNext) btnNext.addEventListener('click', function (e){ e.preventDefault(); go(1); });\n  root.addEventListener('keydown', function (e){\n    if (e.key === 'ArrowUp')  { e.preventDefault(); go(-1); }\n    if (e.key === 'ArrowDown'){ e.preventDefault(); go(1);  }\n  });\n  if (CONFIG.pauseOnHover){\n    root.addEventListener('mouseenter', stopAuto);\n    root.addEventListener('mouseleave', startAuto);\n  }\n  root.setAttribute('data-testi-ready','');\n  render();\n  startAuto();\n})();\n</script>\n  ",
    "bodyStart": "<script>document.body.className=\"body\";</script>"
  }
};
