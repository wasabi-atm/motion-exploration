  <Fragment slot="head">
<style is:inline>
  /* ─── QUIZ ─── */
  [data-quiz]:not([data-quiz-ready]) [data-quiz-step]:not(:first-of-type){ display:none !important; }
  [data-quiz]:not([data-quiz-ready]) [data-quiz-result]{ display:none !important; }
  [hidden]{ display:none !important; }
  [data-quiz-progress]{ transition: background-color .25s ease, opacity .25s ease; }
  [data-quiz-progress].is-active{ background-color:#581DE3; opacity:1; }
  [data-quiz][data-quiz-result-value] [data-quiz-progress]{
    display: none !important;
  }
  @keyframes quizShake { 0%,100%{transform:translateX(0)} 25%{transform:translateX(-5px)} 75%{transform:translateX(5px)} }
  [data-quiz-step].is-invalid{ animation: quizShake .35s ease; }
  [data-quiz-option]{
    cursor: pointer;
    transition: border-color .2s ease, background-color .2s ease, box-shadow .2s ease;
  }
  [data-quiz-option].is-selected{
  border: 1px solid #581DE3 !important;
  background: linear-gradient(90deg, rgba(15, 10, 45, 0.95), rgba(75, 40, 155, 0.55), rgba(15, 10, 45, 0.95)) !important;
  box-shadow: 0 0 0 1px rgba(135,100,255,0.6), 0 0 18px rgba(135,100,255,0.25);
}
  [data-quiz-option] .check-icon{
    opacity: .35;
    transition: opacity .2s ease, filter .2s ease;
  }
  [data-quiz-option].is-selected .check-icon{
    opacity: 1;
    filter: drop-shadow(0 0 5px rgba(135,100,255,0.7));
  }
  [data-quiz-option]:not(.is-selected):hover{
    border-color: rgba(135,100,255,0.4);
  }
</style>
<style is:inline>
  /* ─── TESTIMONIAL ─── */
  [data-testi]:not([data-testi-ready]) [data-testi-slide]:not(:first-of-type){ display:none !important; }
  [data-testi-slide][hidden]{ display:none !important; }
  [data-testi-avatar]{ display:none !important; }
  /* Slide content animations */
  @keyframes testiFade     { from{ opacity:0; transform:translateY(6px);  } to{ opacity:1; transform:none; } }
  @keyframes testiFadeUp   { from{ opacity:0; transform:translateY(24px); } to{ opacity:1; transform:none; } }
  @keyframes testiFadeDown { from{ opacity:0; transform:translateY(-24px);} to{ opacity:1; transform:none; } }
  [data-testi-slide]:not([hidden]):not(.slide-up):not(.slide-down){ animation: testiFade .35s ease; }
  [data-testi-slide].slide-up:not([hidden])  { animation: testiFadeUp   .4s cubic-bezier(.4,0,.2,1); }
  [data-testi-slide].slide-down:not([hidden]){ animation: testiFadeDown .4s cubic-bezier(.4,0,.2,1); }
  [data-testi-prev], [data-testi-next]{ cursor:pointer; user-select:none; }
  [data-testi-prev].is-disabled, [data-testi-next].is-disabled{ opacity:.3; pointer-events:none; }
  [data-testi-rail] img{ transition: opacity .3s ease; }
  .testi-cs-title{
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .testi-brand-logo{
    background-repeat: no-repeat;
    background-size: contain;
    background-position: left center;
  }
</style>
