<!--  ═══════════════════════ QUIZ ═══════════════════════  -->
  <script is:inline>
(function () {
  'use strict';
  var CONFIG = {
    // Q1 slider: budget (£k) → skor per plan
    sliderScore: function (v) {
      if (v >= 50) return { subscription: 3 };
      if (v >= 20) return { creativecredits: 2, subscription: 2 };
      if (v >= 8)  return { creativecredits: 3, fixedprice: 1 };
      if (v >= 3)  return { fixedprice: 2, creativecredits: 1 };
      return { fixedprice: 3 };                       // 1–3
    },
    priority: ['subscription', 'creativecredits', 'fixedprice'], // tie-break order
    defaultResult: 'subscription',
    requireSelection: true,
    selectedClass: 'is-selected'
  };
  var norm = function (s) { return (s || '').toLowerCase().replace(/\s+/g, ''); };
  var root = document.querySelector('[data-quiz]');
  if (!root) return;
  var steps = [].slice.call(root.querySelectorAll('[data-quiz-step]'));
  var segments = [].slice.call(root.querySelectorAll('[data-quiz-progress]'));
  var resultStep = null;
  steps.forEach(function (s) { if (s.querySelector('[data-quiz-result]')) resultStep = s; });
  var resultIndex = resultStep ? steps.indexOf(resultStep) : -1;
  var resultBlocks = resultStep
    ? [].slice.call(resultStep.querySelectorAll('[data-quiz-result]')) : [];
  var questionCount = resultIndex >= 0 ? resultIndex : steps.length;
  var current = 0;
  function hide(el){ if (el){ el.setAttribute('hidden',''); el.style.display = 'none'; } }
  function show(el){ if (el){ el.removeAttribute('hidden'); el.style.display = ''; } }
  function slider(step){ return step.querySelector('input[type="range"]'); }
  function hasOptions(step){ return !!step.querySelector('[data-quiz-option]'); }
  function selected(step){ return step.querySelector('[data-quiz-option].' + CONFIG.selectedClass); }
  // --- Scoring helpers ---
  function parseScore(str){                 // "subscription:2,fixedprice:1" → {subscription:2, fixedprice:1}
    var out = {};
    (str || '').split(',').forEach(function (pair){
      var kv = pair.split(':');
      var plan = norm(kv[0]);
      var pts  = parseInt(kv[1], 10);
      if (plan && !isNaN(pts)) out[plan] = (out[plan] || 0) + pts;
    });
    return out;
  }
  function addScores(tally, scores){
    Object.keys(scores).forEach(function (k){ tally[k] = (tally[k] || 0) + scores[k]; });
  }
  function updateProgress(){
    var activeUpTo = (current >= resultIndex && resultIndex >= 0)
      ? questionCount - 1
      : current;
    segments.forEach(function (seg, i){ seg.classList.toggle('is-active', i <= activeUpTo); });
  }
  function showStep(i){
    current = Math.max(0, Math.min(i, steps.length - 1));
    steps.forEach(function (step, idx){ idx === current ? show(step) : hide(step); });
    updateProgress();
  }
  function validCurrent(){
    var step = steps[current];
    if (CONFIG.requireSelection && hasOptions(step) && !selected(step)){
      step.classList.add('is-invalid');
      setTimeout(function(){ step.classList.remove('is-invalid'); }, 500);
      return false;
    }
    return true;
  }
  function computeResult(){
    var tally = {};
    steps.forEach(function (step, idx){
      if (idx === resultIndex) return;
      var s = slider(step);
      if (s){ addScores(tally, CONFIG.sliderScore(parseInt(s.value, 10))); return; }
      var opt = selected(step);
      if (opt) addScores(tally, parseScore(opt.getAttribute('data-score')));
    });
    // Pemenang; tie-break pakai urutan CONFIG.priority
    var order = CONFIG.priority.slice();
    Object.keys(tally).forEach(function (k){ if (order.map(norm).indexOf(k) === -1) order.push(k); });
    var winner = CONFIG.defaultResult, best = -Infinity;
    order.forEach(function (p){ var c = tally[norm(p)] || 0; if (c > best){ best = c; winner = p; } });
    return winner;
  }
  function revealWinner(winner){
    resultBlocks.forEach(function (b){
      norm(b.getAttribute('data-quiz-result')) === norm(winner) ? show(b) : hide(b);
    });
  }
  function goResult(){
    var winner = computeResult();
    showStep(resultIndex);
    revealWinner(winner);
    root.setAttribute('data-quiz-result-value', winner);
  }
  function restart(){
    steps.forEach(function (step){
      [].forEach.call(step.querySelectorAll('[data-quiz-option].' + CONFIG.selectedClass),
        function (o){ o.classList.remove(CONFIG.selectedClass); });
      var s = slider(step);
      if (s) s.value = s.defaultValue;
    });
    resultBlocks.forEach(hide);
    root.removeAttribute('data-quiz-result-value');
    showStep(0);
  }
  root.addEventListener('click', function (e){
    var opt = e.target.closest('[data-quiz-option]');
    if (opt){
      var step = opt.closest('[data-quiz-step]');
      [].forEach.call(step.querySelectorAll('[data-quiz-option]'),
        function (s){ s.classList.remove(CONFIG.selectedClass); });
      opt.classList.add(CONFIG.selectedClass);
      return;
    }
    if (e.target.closest('[data-quiz-next]')){
      e.preventDefault();
      if (!validCurrent()) return;
      var next = current + 1;
      (resultIndex >= 0 && next === resultIndex) ? goResult() : showStep(next);
      return;
    }
    if (e.target.closest('[data-quiz-prev]')){
      e.preventDefault();
      showStep(current - 1);
      return;
    }
    if (e.target.closest('[data-quiz-restart]')){
      e.preventDefault();
      restart();
    }
  });
  steps.forEach(function (step, i){ if (i !== 0) hide(step); });
  resultBlocks.forEach(hide);
  root.setAttribute('data-quiz-ready','');
  showStep(0);
})();
</script>
  <!--  ═══════════════════════ TESTIMONIAL ═══════════════════════  -->
  <script is:inline>
(function () {
  'use strict';
  var CONFIG = {
    loop: false,
    autoplay: false,
    autoplayDelay: 6000,
    pauseOnHover: true
  };
  var ANIM_MS = 400;
  var isAnimating = false;
  var root = document.querySelector('[data-testi]');
  if (!root) return;
  var slides = [].slice.call(root.querySelectorAll('[data-testi-slide]'));
  if (!slides.length) return;
  var railPrev = root.querySelector('[data-testi-rail="prev"]');
  var railCurr = root.querySelector('[data-testi-rail="current"]');
  var railNext = root.querySelector('[data-testi-rail="next"]');
  var btnPrev  = root.querySelector('[data-testi-prev]');
  var btnNext  = root.querySelector('[data-testi-next]');
  var N = slides.length;
  var index = 0;
  var timer = null;
  function avatarSrc(i){
    if (i == null || !slides[i]) return '';
    var el = slides[i].querySelector('[data-testi-avatar]');
    if (!el) return '';
    var src = el.currentSrc || el.src || el.getAttribute('src') || '';
    if (src && src.indexOf('placeholder') === -1) return src;
    var bg = el.style.backgroundImage || '';
    var match = bg.match(/url\(["']?(.*?)["']?\)/);
    if (match && match[1]) return match[1];
    return '';
  }
  function setSlot(slot, i){
    if (!slot) return;
    var url = avatarSrc(i);
    var img = slot.querySelector('img');
    if (img){
      if (url){ img.src = url; slot.style.visibility = ''; }
      else { slot.style.visibility = 'hidden'; }
    } else {
      if (url){ slot.style.backgroundImage = 'url("' + url + '")'; slot.style.visibility = ''; }
      else { slot.style.visibility = 'hidden'; }
    }
  }
  function neighbor(i, dir){
    var j = i + dir;
    if (j < 0)  return CONFIG.loop ? N - 1 : null;
    if (j >= N) return CONFIG.loop ? 0 : null;
    return j;
  }
  function render(slideDir){
    slides.forEach(function (s, i){
      s.classList.remove('slide-up', 'slide-down');
      if (i === index){
        s.removeAttribute('hidden');
        if (slideDir) s.classList.add(slideDir > 0 ? 'slide-up' : 'slide-down');
      } else {
        s.setAttribute('hidden','');
      }
    });
    setSlot(railCurr, index);
    setSlot(railPrev, neighbor(index, -1));
    setSlot(railNext, neighbor(index, 1));
    if (btnPrev) btnPrev.classList.toggle('is-disabled', !CONFIG.loop && index === 0);
    if (btnNext) btnNext.classList.toggle('is-disabled', !CONFIG.loop && index === N - 1);
    root.setAttribute('data-testi-index', index);
  }
  function go(dir){
    if (isAnimating) return;
    var j = neighbor(index, dir);
    if (j == null) return;
    isAnimating = true;
    var slots = [railPrev, railCurr, railNext].filter(Boolean);
    var axis  = window.innerWidth <= 479 ? 'X' : 'Y';   // mobile horizontal, desktop vertical
    var shift = dir > 0 ? -70 : 70;
    var ease  = 'cubic-bezier(.4,0,.2,1)';
    var tOut  = Math.round(ANIM_MS * 0.75);
    var tFade = Math.round(ANIM_MS * 0.5);
    /* Phase 1 — push current avatars out */
    slots.forEach(function (s){
      s.style.transition = 'transform ' + tOut + 'ms ' + ease + ', opacity ' + tFade + 'ms ease';
      s.style.transform  = 'translate' + axis + '(' + shift + 'px)';
      s.style.opacity    = '0';
    });
    setTimeout(function (){
      /* Update index + content */
      index = j;
      render(dir);
      /* Position avatars on opposite side (no transition) */
      slots.forEach(function (s){
        s.style.transition = 'none';
        s.style.transform  = 'translate' + axis + '(' + (-shift) + 'px)';
        s.style.opacity    = '0';
      });
      /* Force reflow */
      void root.offsetWidth;
      /* Phase 2 — push new avatars in */
      slots.forEach(function (s){
        s.style.transition = 'transform ' + tOut + 'ms ' + ease + ', opacity ' + tFade + 'ms ease';
        s.style.transform  = 'translate' + axis + '(0)';
        s.style.opacity    = '1';
      });
      setTimeout(function (){
        slots.forEach(function (s){
          s.style.transition = '';
          s.style.transform  = '';
          s.style.opacity    = '';
        });
        isAnimating = false;
      }, ANIM_MS);
    }, tOut);
  }
  function startAuto(){
    if (!CONFIG.autoplay || N < 2) return;
    stopAuto();
    timer = setInterval(function (){ go(1); }, CONFIG.autoplayDelay);
  }
  function stopAuto(){ if (timer){ clearInterval(timer); timer = null; } }
  if (btnPrev) btnPrev.addEventListener('click', function (e){ e.preventDefault(); go(-1); });
  if (btnNext) btnNext.addEventListener('click', function (e){ e.preventDefault(); go(1); });
  root.addEventListener('keydown', function (e){
    if (e.key === 'ArrowUp')  { e.preventDefault(); go(-1); }
    if (e.key === 'ArrowDown'){ e.preventDefault(); go(1);  }
  });
  if (CONFIG.pauseOnHover){
    root.addEventListener('mouseenter', stopAuto);
    root.addEventListener('mouseleave', startAuto);
  }
  root.setAttribute('data-testi-ready','');
  render();
  startAuto();
})();
</script>
