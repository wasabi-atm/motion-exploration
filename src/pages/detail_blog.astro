<style is:inline>
/* Show tooltip only when wrapper has data-tooltip */
.author-role-wrapper[data-tooltip]:hover::after {
  content: attr(data-tooltip);
  position: absolute;
  right: 0;        /* align to top-right */
  bottom: 100%;    /* place tooltip above, not below */
  margin-bottom: 6px;
  padding: 6px 8px;
  max-width: 280px;
  background: #ffffff;
  color: #6229e6;
  font-size: 11px;
  line-height: 1.4;
