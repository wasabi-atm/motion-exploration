---
import '../styles/theme.css';
import { BaseLayout, Embed } from 'meno-astro/components';
import NavBanner from '../components/NavBanner.astro';
import Footer from '../components/Footer.astro';

const meta = {
  "title": "Motion The Agency",
  "description": "",
  "htmlAttributes": {
    "data-wf-page": "670fae109cfe94e7e7f7e472",
    "data-wf-site": "66ebfb6ec8f20d5eda50eb34"
  },
  "ogType": "website",
  "customCode": {
    "head": "\n<!--  [Attributes by Finsweet] Social Share  -->\n<script defer=\"\" src=\"https://cdn.jsdelivr.net/npm/@finsweet/attributes-socialshare@1/socialshare.js\"></script>\n<!--  [Attributes by Finsweet] Table of Contents  -->\n<script defer=\"\" src=\"https://cdn.jsdelivr.net/npm/@finsweet/attributes-toc@1/toc.js\"></script>\n<style>\n.w-richtext h6 a {\n  color: #FFFFFF;\n</style>\n<script src=\"https://cdn.jsdelivr.net/npm/flowbitz@latest/dist/flowbitz.umd.js\"></script>\n<style>\n/* Show tooltip only when wrapper has data-tooltip */\n.author-role-wrapper[data-tooltip]:hover::after {\n  content: attr(data-tooltip);\n  position: absolute;\n  right: 0;        /* align to top-right */\n  bottom: 100%;    /* place tooltip above, not below */\n  margin-bottom: 6px;\n  padding: 6px 8px;\n  max-width: 280px;\n  background: #ffffff;\n  color: #6229e6;\n  font-size: 11px;\n  line-height: 1.4;\n  border-radius: 6px;\n  box-shadow: 0 8px 20px rgba(0,0,0,0.15);\n  white-space: normal;\n  z-index: 999;\n}\n</style>\n<style>\n/* ===============================\n   FIX BLOG BANNER INSIDE RICH TEXT\n   =============================== */\n.w-richtext .blog-banner .flex-v-24,\n.w-richtext .blog-banner .gap-12,\n.w-richtext .blog-banner .flex-v-4 {\n  display: flex !important;\n  flex-direction: column !important;\n}\n/* Re-apply intended spacing */\n.w-richtext .blog-banner .flex-v-24 { gap: 24px !important; }\n.w-richtext .blog-banner .gap-12   { gap: 12px !important; }\n.w-richtext .blog-banner .flex-v-4 { gap: 4px !important; }\n/* Restore flex + gap utilities inside blog content */\n/* Kill rich text typography side-effects */\n.w-richtext .blog-banner * {\n  margin: 0;\n}\n/* Fix CTA link color + underline hijack */\n.w-richtext .blog-banner a.blog-banner-cta {\n  color: inherit !important;\n  text-decoration: none !important;\n}\n</style>\n<!--  CMS ARTICLES CUSTOM COMPONENTS STYLING */  -->\n<link rel=\"stylesheet\" href=\"https://api.fontshare.com/v2/css?f[]=switzer@400,500&display=swap\">\n<style>\n /* =========================\n   TABLE (ORIGINAL FORMAT)\n========================= */\n#mt-table-embed,\n#mt-table-embed * {\n  box-sizing: border-box;\n  opacity: 1 !important;\n  mix-blend-mode: normal !important;\n  filter: none !important;\n  color: inherit;\n}\n#mt-table-embed {\n  --bg: #ffffff;\n  --text: #333333;\n  --border: #dcdcdc;\n  --hover: #f9f9ff;\n  --gradA: #581DE3;\n  --gradB: #726EFF;\n  --radius: 12px;\n  --shadow: 0 2px 6px rgba(0,0,0,0.08);\n  --font: \"Switzer\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, \"Noto Sans\";\n  --fs: 18px;\n  --head-w: 500;\n  --pad: 14px 18px;\n  width: 100%;\n  max-width: 100%;\n  min-width: 0;\n  isolation: isolate;\n  background: transparent;\n  overflow: hidden;\n  color-scheme: light;\n}\n#mt-table-embed .wrap {\n  width: 100%;\n  max-width: 100%;\n  min-width: 0;\n  overflow-x: auto;\n  overflow-y: hidden;\n  -webkit-overflow-scrolling: touch;\n}\n#mt-table-embed table {\n  width: 100%;\n  min-width: 720px; /* key fix: prevents squeezed mobile columns */\n  border-spacing: 0;\n  border-collapse: separate;\n  background: var(--bg);\n  font-family: var(--font);\n  font-size: var(--fs);\n  box-shadow: var(--shadow);\n  border-radius: var(--radius);\n  overflow: hidden;\n  table-layout: auto; /* key fix: lets columns breathe */\n}\n#mt-table-embed th,\n#mt-table-embed td {\n  border: 1px solid var(--border);\n  padding: var(--pad);\n  vertical-align: top;\n  word-break: normal;\n  overflow-wrap: break-word;\n}\n#mt-table-embed thead th {\n  background: linear-gradient(45deg, var(--gradA), var(--gradB));\n  color: #fff;\n  font-weight: var(--head-w);\n  text-align: left;\n  line-height: 1.25;\n  white-space: nowrap; /* prevents header letters stacking */\n}\n#mt-table-embed tbody td {\n  background: #fff;\n  color: var(--text);\n}\n#mt-table-embed tbody tr:hover {\n  background: var(--hover);\n}\n#mt-table-embed thead tr:first-child th:first-child {\n  border-top-left-radius: var(--radius);\n}\n#mt-table-embed thead tr:first-child th:last-child {\n  border-top-right-radius: var(--radius);\n}\n#mt-table-embed tbody tr:last-child td:first-child {\n  border-bottom-left-radius: var(--radius);\n}\n#mt-table-embed tbody tr:last-child td:last-child {\n  border-bottom-right-radius: var(--radius);\n}\n#mt-table-embed .wrap::-webkit-scrollbar {\n  height: 8px;\n}\n#mt-table-embed .wrap::-webkit-scrollbar-thumb {\n  background: #ddd;\n  border-radius: 8px;\n}\n/* Mobile: slightly smaller text and padding, still scrollable */\n@media (max-width: 767px) {\n  #mt-table-embed {\n    --fs: 15px;\n    --pad: 12px 14px;\n  }\n  #mt-table-embed table {\n    min-width: 760px;\n  }\n}\n</style>\n<style>\n  /* =========================\n     FAQ (ORIGINAL FORMAT)\n  ========================= */\n  #mt-faq, #mt-faq * {\n    box-sizing: border-box;\n    opacity: 1 !important;\n    mix-blend-mode: normal !important;\n    filter: none !important;\n  }\n  #mt-faq {\n    --text: #080610;\n    --muted: #4b5563;\n    --border: #dcdcdc;\n    --radius: 12px;\n    --shadow: 0 6px 16px rgba(0,0,0,0.06);\n    --font: \"Switzer\", ui-sans-serif, system-ui;\n    --gradA: #581DE3;\n    --gradB: #726EFF;\n    --item-grad: linear-gradient(90deg, rgba(88,29,227,0.06), rgba(114,110,255,0.08));\n    --q-size: 18px;\n    --a-size: 16px;\n    max-width: 1100px;\n    margin: 0 auto;\n    font-family: var(--font);\n    color: var(--text);\n  }\n  #mt-faq .wrap {\n    border: 1px solid var(--border);\n    border-radius: var(--radius);\n    overflow: hidden;\n    background: #fff;\n    box-shadow: var(--shadow);\n  }\n  #mt-faq .q {\n    width: 100%;\n    padding: 18px 22px;\n    cursor: pointer;\n    display: grid;\n    grid-template-columns: 1fr auto;\n    align-items: center;\n    background: var(--item-grad);\n    border: 0;\n    color: var(--text);\n    font-size: var(--q-size);\n    font-weight: 500;\n    text-align: left;\n  }\n  #mt-faq .q:hover {\n    background: linear-gradient(90deg, rgba(88,29,227,0.10), rgba(114,110,255,0.12));\n  }\n  #mt-faq .item + .item .q {\n    border-top: 1px solid var(--border);\n  }\n  #mt-faq .icon {\n    font-size: 24px;\n    font-weight: 600;\n    width: 26px;\n    text-align: center;\n    line-height: 1;\n    background: linear-gradient(45deg, var(--gradA), var(--gradB));\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n  #mt-faq .a {\n    background: #fff;\n    max-height: 0;\n    overflow: hidden;\n    padding: 0 22px;\n    transition: max-height .3s ease;\n  }\n  #mt-faq .inner {\n    padding: 14px 0 20px 0;\n    font-size: var(--a-size);\n    color: var(--muted);\n  }\n  #mt-faq .inner p { margin: 0 0 12px; }\n  #mt-faq .inner ul { margin: 8px 0 0 20px; }\n  #mt-faq .inner li { margin: 6px 0; }\n</style>\n  <meta name=\"twitter:card\" content=\"summary_large_image\">",
    "bodyEnd": "\n<!--  copy link button  -->\n  <script>\nvar $temp = $(\"<input>\");\nvar $url = $(location).attr('href');\n$('[copy-button]').on('click', function() {\n\t$(\"body\").append($temp);\n  $temp.val($url).select();\n  document.execCommand(\"copy\");\n  $temp.remove();\n  $(\"[copy-text]\").text(\"copied\");\n  $(\"[copy-icon]\").css('display', 'none');\n  setTimeout(function() {\n      $(\"[copy-text]\").text(\" \");\n      $(\"[copy-icon]\").css('display', 'block');\n  }, 1000);\n});\n</script>\n  <script>\n  document.addEventListener(\"DOMContentLoaded\", function() {\n    const richTextImages = document.querySelectorAll('.w-richtext img');\n    richTextImages.forEach(function(img) {\n      img.removeAttribute('loading');\n    });\n  });\n</script>\n  <script>\ndocument.addEventListener(\"DOMContentLoaded\", function() {\n  document.querySelectorAll(\".authors-list-wrapper\").forEach(function(wrapper) {\n    const links = Array.from(wrapper.querySelectorAll(\".name-wrapper\"));\n    const count = links.length;\n    if (count <= 1) return;\n    links.forEach(function(link, index) {\n      if (index === count - 1) return;\n      const sep = document.createElement(\"span\");\n      if (count === 2) {\n        // A & B\n        if (index === 0) {\n          sep.textContent = \" & \";\n          sep.style.marginLeft = \"8px\"; // <-- add space before &\n        }\n      } else {\n        // A, B & C\n        if (index < count - 2) {\n          sep.textContent = \", \";\n        } else {\n          sep.textContent = \" & \";\n          sep.style.marginLeft = \"8px\"; // <-- add space before &\n        }\n      }\n      link.after(sep);\n    });\n  });\n});\n</script>\n  <script>\ndocument.addEventListener(\"DOMContentLoaded\", function() {\n  const items = document.querySelectorAll('.author-role-wrapper');\n  items.forEach(function(wrapper) {\n    const text = wrapper.querySelector('.author-role-text');\n    if (!text) return;\n    const fullText = text.textContent.trim();\n    const isTruncated = text.scrollWidth > text.clientWidth;\n    if (isTruncated) {\n      wrapper.setAttribute(\"data-tooltip\", fullText);\n    } else {\n      wrapper.removeAttribute(\"data-tooltip\");\n    }\n  });\n});\n</script>\n  <!--  FAQ Component  -->\n  <script>\n(function () {\n  function setOpen(item, open) {\n    const panel = item.querySelector('.a');\n    const icon = item.querySelector('.icon');\n    if (!panel || !icon) return;\n    if (open) {\n      item.classList.add('open');\n      panel.style.setProperty('max-height', panel.scrollHeight + 'px');\n      icon.textContent = '−';\n    } else {\n      item.classList.remove('open');\n      panel.style.setProperty('max-height', '0px');\n      icon.textContent = '+';\n    }\n  }\n  // Works even for CMS-injected content because it's delegated\n  document.addEventListener('click', function (e) {\n    const btn = e.target.closest('#mt-faq .q');\n    if (!btn) return;\n    const root = btn.closest('#mt-faq');\n    const item = btn.closest('.item');\n    if (!root || !item) return;\n    const isOpen = item.classList.contains('open');\n    // Close siblings (same behavior as your original)\n    root.querySelectorAll('.item.open').forEach(function (i) {\n      if (i !== item) setOpen(i, false);\n    });\n    setOpen(item, !isOpen);\n  });\n  // Keep height correct on resize\n  window.addEventListener('resize', function () {\n    document.querySelectorAll('#mt-faq .item.open').forEach(function (item) {\n      const panel = item.querySelector('.a');\n      if (panel) panel.style.setProperty('max-height', panel.scrollHeight + 'px');\n    });\n  });\n})();\n</script>\n  <style>\n/* Desktop only */\n@media (min-width: 768px) {\n  .author-desc-list .author-desc-item.last-span-2 {\n    grid-column: span 2 !important;\n  }\n}\n/* Mobile fallback */\n@media (max-width: 767px) {\n  .author-desc-list .author-desc-item.last-span-2 {\n    grid-column: auto !important;\n  }\n}\n</style>\n  <script>\ndocument.addEventListener(\"DOMContentLoaded\", function() {\n  const items = document.querySelectorAll(\".author-desc-list .author-desc-item\");\n  if (items.length % 2 !== 0) {\n    // Add a special class to the last item\n    items[items.length - 1].classList.add(\"last-span-2\");\n  }\n});\n</script>\n  ",
    "bodyStart": "<script>document.body.className=\"body overflow-visible\";</script>"
  }
};
