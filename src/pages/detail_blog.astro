  <script is:inline>
document.addEventListener("DOMContentLoaded", function() {
  document.querySelectorAll(".authors-list-wrapper").forEach(function(wrapper) {
    const links = Array.from(wrapper.querySelectorAll(".name-wrapper"));
    const count = links.length;
    if (count <= 1) return;
    links.forEach(function(link, index) {
      if (index === count - 1) return;
      const sep = document.createElement("span");
      if (count === 2) {
        // A & B
        if (index === 0) {
          sep.textContent = " & ";
          sep.style.marginLeft = "8px"; // <-- add space before &
        }
      } else {
        // A, B & C
        if (index < count - 2) {
          sep.textContent = ", ";
        } else {
          sep.textContent = " & ";
          sep.style.marginLeft = "8px"; // <-- add space before &
        }
      }
      link.after(sep);
    });
  });
});
</script>
  <script is:inline>
document.addEventListener("DOMContentLoaded", function() {
  const items = document.querySelectorAll('.author-role-wrapper');
  items.forEach(function(wrapper) {
    const text = wrapper.querySelector('.author-role-text');
    if (!text) return;
    const fullText = text.textContent.trim();
    const isTruncated = text.scrollWidth > text.clientWidth;
    if (isTruncated) {
      wrapper.setAttribute("data-tooltip", fullText);
    } else {
      wrapper.removeAttribute("data-tooltip");
    }
  });
});
</script>
  <!--  FAQ Component  -->
  <script is:inline>
(function () {
  function setOpen(item, open) {
    const panel = item.querySelector('.a');
    const icon = item.querySelector('.icon');
    if (!panel || !icon) return;
    if (open) {
      item.classList.add('open');
      panel.style.setProperty('max-height', panel.scrollHeight + 'px');
      icon.textContent = '−';
    } else {
      item.classList.remove('open');
      panel.style.setProperty('max-height', '0px');
      icon.textContent = '+';
    }
  }
  // Works even for CMS-injected content because it's delegated
  document.addEventListener('click', function (e) {
    const btn = e.target.closest('#mt-faq .q');
    if (!btn) return;
    const root = btn.closest('#mt-faq');
    const item = btn.closest('.item');
    if (!root || !item) return;
    const isOpen = item.classList.contains('open');
    // Close siblings (same behavior as your original)
    root.querySelectorAll('.item.open').forEach(function (i) {
      if (i !== item) setOpen(i, false);
    });
    setOpen(item, !isOpen);
  });
  // Keep height correct on resize
  window.addEventListener('resize', function () {
    document.querySelectorAll('#mt-faq .item.open').forEach(function (item) {
      const panel = item.querySelector('.a');
      if (panel) panel.style.setProperty('max-height', panel.scrollHeight + 'px');
    });
  });
})();
</script>
