  box-shadow: 0 8px 20px rgba(0,0,0,0.15);
  white-space: normal;
  z-index: 999;
}
</style>
<style is:inline>
/* ===============================
   FIX BLOG BANNER INSIDE RICH TEXT
   =============================== */
.w-richtext .blog-banner .flex-v-24,
.w-richtext .blog-banner .gap-12,
.w-richtext .blog-banner .flex-v-4 {
  display: flex !important;
  flex-direction: column !important;
}
/* Re-apply intended spacing */
.w-richtext .blog-banner .flex-v-24 { gap: 24px !important; }
.w-richtext .blog-banner .gap-12   { gap: 12px !important; }
.w-richtext .blog-banner .flex-v-4 { gap: 4px !important; }
/* Restore flex + gap utilities inside blog content */
/* Kill rich text typography side-effects */
.w-richtext .blog-banner * {
  margin: 0;
}
/* Fix CTA link color + underline hijack */
.w-richtext .blog-banner a.blog-banner-cta {
  color: inherit !important;
  text-decoration: none !important;
}
</style>
<!--  CMS ARTICLES CUSTOM COMPONENTS STYLING */  -->
<link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=switzer@400,500&display=swap">
<style is:inline>
 /* =========================
   TABLE (ORIGINAL FORMAT)
========================= */
#mt-table-embed,
#mt-table-embed * {
  box-sizing: border-box;
  opacity: 1 !important;
  mix-blend-mode: normal !important;
  filter: none !important;
  color: inherit;
}
#mt-table-embed {
  --bg: #ffffff;
  --text: #333333;
  --border: #dcdcdc;
  --hover: #f9f9ff;
  --gradA: #581DE3;
  --gradB: #726EFF;
  --radius: 12px;
  --shadow: 0 2px 6px rgba(0,0,0,0.08);
  --font: "Switzer", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans";
  --fs: 18px;
  --head-w: 500;
  --pad: 14px 18px;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  isolation: isolate;
  background: transparent;
  overflow: hidden;
  color-scheme: light;
}
#mt-table-embed .wrap {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  overflow-x: auto;
  overflow-y: hidden;
  -webkit-overflow-scrolling: touch;
}
#mt-table-embed table {
  width: 100%;
  min-width: 720px; /* key fix: prevents squeezed mobile columns */
  border-spacing: 0;
  border-collapse: separate;
  background: var(--bg);
  font-family: var(--font);
  font-size: var(--fs);
  box-shadow: var(--shadow);
  border-radius: var(--radius);
  overflow: hidden;
  table-layout: auto; /* key fix: lets columns breathe */
}
#mt-table-embed th,
#mt-table-embed td {
  border: 1px solid var(--border);
  padding: var(--pad);
  vertical-align: top;
  word-break: normal;
  overflow-wrap: break-word;
}
#mt-table-embed thead th {
  background: linear-gradient(45deg, var(--gradA), var(--gradB));
  color: #fff;
  font-weight: var(--head-w);
  text-align: left;
  line-height: 1.25;
  white-space: nowrap; /* prevents header letters stacking */
}
#mt-table-embed tbody td {
  background: #fff;
  color: var(--text);
}
#mt-table-embed tbody tr:hover {
  background: var(--hover);
}
#mt-table-embed thead tr:first-child th:first-child {
  border-top-left-radius: var(--radius);
}
#mt-table-embed thead tr:first-child th:last-child {
  border-top-right-radius: var(--radius);
}
#mt-table-embed tbody tr:last-child td:first-child {
  border-bottom-left-radius: var(--radius);
}
#mt-table-embed tbody tr:last-child td:last-child {
  border-bottom-right-radius: var(--radius);
}
#mt-table-embed .wrap::-webkit-scrollbar {
  height: 8px;
}
#mt-table-embed .wrap::-webkit-scrollbar-thumb {
  background: #ddd;
  border-radius: 8px;
}
/* Mobile: slightly smaller text and padding, still scrollable */
@media (max-width: 767px) {
  #mt-table-embed {
    --fs: 15px;
    --pad: 12px 14px;
  }
  #mt-table-embed table {
    min-width: 760px;
  }
}
</style>
<style is:inline>
  /* =========================
     FAQ (ORIGINAL FORMAT)
  ========================= */
  #mt-faq, #mt-faq * {
    box-sizing: border-box;
    opacity: 1 !important;
    mix-blend-mode: normal !important;
    filter: none !important;
  }
  #mt-faq {
    --text: #080610;
    --muted: #4b5563;
    --border: #dcdcdc;
    --radius: 12px;
    --shadow: 0 6px 16px rgba(0,0,0,0.06);
    --font: "Switzer", ui-sans-serif, system-ui;
    --gradA: #581DE3;
    --gradB: #726EFF;
    --item-grad: linear-gradient(90deg, rgba(88,29,227,0.06), rgba(114,110,255,0.08));
    --q-size: 18px;
    --a-size: 16px;
    max-width: 1100px;
    margin: 0 auto;
    font-family: var(--font);
    color: var(--text);
  }
  #mt-faq .wrap {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: #fff;
    box-shadow: var(--shadow);
  }
  #mt-faq .q {
    width: 100%;
    padding: 18px 22px;
    cursor: pointer;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    background: var(--item-grad);
    border: 0;
    color: var(--text);
    font-size: var(--q-size);
    font-weight: 500;
    text-align: left;
  }
  #mt-faq .q:hover {
    background: linear-gradient(90deg, rgba(88,29,227,0.10), rgba(114,110,255,0.12));
  }
  #mt-faq .item + .item .q {
    border-top: 1px solid var(--border);
  }
  #mt-faq .icon {
    font-size: 24px;
    font-weight: 600;
    width: 26px;
    text-align: center;
    line-height: 1;
    background: linear-gradient(45deg, var(--gradA), var(--gradB));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  #mt-faq .a {
    background: #fff;
    max-height: 0;
    overflow: hidden;
    padding: 0 22px;
    transition: max-height .3s ease;
  }
  #mt-faq .inner {
    padding: 14px 0 20px 0;
    font-size: var(--a-size);
    color: var(--muted);
  }
  #mt-faq .inner p { margin: 0 0 12px; }
  #mt-faq .inner ul { margin: 8px 0 0 20px; }
  #mt-faq .inner li { margin: 6px 0; }
</style>
