---
import '../styles/theme.css';
import { BaseLayout, Embed } from 'meno-astro/components';
import NavBanner from '../components/NavBanner.astro';
import Footer from '../components/Footer.astro';

const meta = {
  "title": "Motion The Agency",
  "description": "",
  "htmlAttributes": {
    "data-wf-page": "67b4417cbb3533c4eaa452c6",
    "data-wf-site": "66ebfb6ec8f20d5eda50eb34"
  },
  "customCode": {
    "head": "",
    "bodyStart": "<script>document.body.className=\"body-4\";</script>"
  }
};
const __embed0 = `<style>
 * {
     -webkit-font-smoothing: antialiased;
     -moz-osx-font-smoothing: grayscale;
     font-smoothing: antialiased;
     text-rendering: optimizeLegibility;
}
  html { font-size: calc(0.625rem + 0.41666666666666663vw); }
  @media screen and (max-width:1920px) { html { font-size: calc(0.625rem + 0.41666666666666674vw); } }
  @media screen and (max-width:1440px) { html { font-size: calc(0.8126951092611863rem + 0.20811654526534862vw); } }
  @media screen and (max-width:479px) { html { font-size: calc(0.7494769874476988rem + 0.8368200836820083vw); } }
.glowing-wrapper-button:after {
	background: radial-gradient(85% 120% at 50% 120%, rgba(255, 255, 255, .24) 0%, rgba(255, 255, 255, 0) 100%);
	border-radius: 999px;
	content: "";
	height: calc(100% + 4px);
	left: -2px;
	opacity: 0;
	position: absolute;
	top: -2px;
	transition: 1s all;
	width: calc(100% + 4px)
}
.glowing-wrapper-button:hover:after {
	opacity: .7
}
.glowing-wrapper-active .glowing-wrapper-animations,
.glowing-wrapper-active .glowing-wrapper-borders-masker {
	opacity: 1
}
.glowing-wrapper-animations:before,
.glowing-wrapper-borders:before {
	content: "";
	float: left;
	padding-top: 100%
}
.glowing-wrapper-animations:after,
.glowing-wrapper-borders:after {
	clear: both;
	content: "";
	display: block
}
.glowing-wrapper-animations {
	pointer-events: none;
}
.glowing-wrapper-animations * {
	height: 100%;
	left: 0;
	position: absolute;
	top: 0;
	width: 100%
}
.glowing-wrapper-borders,
.glowing-wrapper-glow,
.glowing-wrapper-mask {
	animation: borderTurn 2.5s infinite linear;
	background-image: conic-gradient(from 0 at 50% 50%, rgba(255, 255, 255, .5) 0deg, rgba(255, 255, 255, 0) 60deg, rgba(255, 255, 255, 0) 310deg, rgba(255, 255, 255, .5) 360deg);
	background-position: center center;
	background-repeat: no-repeat;
	background-size: cover
}
.glowing-wrapper-mask-wrapper {
	-webkit-mask: url("data:image/svg+xml,url('data:image/svg+xml,%253Csvg width='28' height='24' viewBox='0 0 28 24' fill='none' xmlns='http://www.w3.org/2000/svg'%253E%253Crect width='28' height='24' fill='black'/%253E%253C/svg%253E%250A');");
	mask: url("data:image/svg+xml,url('data:image/svg+xml,%253Csvg width='28' height='24' viewBox='0 0 28 24' fill='none' xmlns='http://www.w3.org/2000/svg'%253E%253Crect width='28' height='24' fill='black'/%253E%253C/svg%253E%250A');");
	mask-repeat: repeat;
	-webkit-mask-size: auto;
	mask-size: auto
}
.glowing-wrapper-borders {
	animation-name: borderTurnWithTranslate
}
.glowing-wrapper-borders-masker {
	content: "";
	inset: 0;
	-webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
	mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
	mask-composite: xor;
	-webkit-mask-composite: xor;
	mask-composite: exclude;
	pointer-events: none;
}
@keyframes borderTurn {
	0% {
		transform: rotate(0)
	}
	to {
		transform: rotate(360deg)
	}
}
@keyframes borderTurnWithTranslate {
	0% {
		transform: translate(-50%, -50%) rotate(0)
	}
	to {
		transform: translate(-50%, -50%) rotate(360deg)
	}
}
                    </style>`;
---
<BaseLayout meta={meta}>
<div data-meno-label="Page content" class="body-4 min-h-screen [background-color:#080610]">
<div class="page-wrapper [color:#fff] [overflow-x:hidden]">
    <NavBanner />
    <div class="w-layout-blockcontainer main-wrapper w-container [margin-left:auto] [margin-right:auto] [max-width:none] [display:block] [z-index:0] [color:#fff] [background-color:#080610] [position:relative] [overflow-x:hidden] max-lg:[max-width:728px] max-sm:[max-width:none] max-landscape:[max-width:none]">
      <section class="section-hero badge-spacing [background-image:url('../images/Hero_1.avif')] [background-position:0_100%] [background-repeat:no-repeat] [background-size:cover] [background-attachment:scroll] [padding-top:220px] [padding-bottom:40px] [margin-bottom:0] [position:relative] max-lg:[background-position:0%] max-lg:[background-size:cover] max-lg:[padding-top:80px] max-sm:[padding-top:64px] max-sm:[padding-bottom:20px] max-landscape:[padding-bottom:20px]">
        <div class="w-layout-blockcontainer container-1280 w-container [margin-left:auto] [margin-right:auto] [max-width:1360px] [display:block] [width:100%] [padding-left:40px] [padding-right:40px] [text-decoration:none] max-lg:[max-width:728px] max-lg:[margin-top:0] max-lg:[padding:40px] max-sm:[max-width:none] max-sm:[padding-top:40px] max-landscape:[max-width:none] max-landscape:[margin-top:0] max-landscape:[padding-top:64px] max-landscape:[padding-left:20px] max-landscape:[padding-right:20px]">
          <div class="gap-60-hero center [grid-column-gap:20px] [grid-row-gap:20px] [flex-flow:column] [justify-content:flex-start] [align-items:center] [height:100%] [display:flex] max-landscape:[grid-column-gap:32px] max-landscape:[grid-row-gap:32px]">
            <div class="left-hero max-w-510 center [grid-column-gap:16px] [grid-row-gap:16px] [flex-flow:column] [justify-content:flex-start] [max-width:640px] [display:flex] [text-align:center] [align-items:center] max-lg:[grid-column-gap:12px] max-lg:[grid-row-gap:12px] max-lg:[text-align:center] max-lg:[order:0] max-lg:[align-items:center] max-lg:[max-width:100%] max-sm:[grid-column-gap:16px] max-sm:[grid-row-gap:16px]">
              <div class="gap-4 [grid-column-gap:12px] [grid-row-gap:12px] [flex-flow:column] [display:flex] max-lg:[justify-content:flex-start] max-lg:[align-items:center]">
                <h1 class="text-caps [color:#fff9] [letter-spacing:4.2px] [text-transform:uppercase] [font-family:Switzer,_sans-serif] [font-size:14px] [font-weight:400] [line-height:150%] [text-decoration:none] max-landscape:[font-size:12px] max-sm:[font-size:10px]">Heading</h1>
                <h1 class="h1 [color:#fff] [text-wrap:balance] [margin-top:0] [margin-bottom:0] [padding-right:0] [font-family:Switzer,_sans-serif] [font-size:48px] [font-weight:600] [line-height:120%] max-lg:[font-size:44px] max-landscape:[font-size:38px] max-sm:[font-size:28px] max-sm:[font-weight:600]">Customer Stories</h1>
              </div>
            </div>
          </div>
        </div>
      </section>
      <div class="w-layout-blockcontainer section-blog w-container [margin-left:auto] [margin-right:auto] [max-width:none] [display:flex] [justify-content:center] [align-items:center] [width:100%] [padding-top:80px] [padding-bottom:80px] [position:relative] [overflow:clip] max-lg:[max-width:728px] max-lg:[padding-top:0] max-lg:[padding-bottom:40px] max-sm:[max-width:none] max-sm:[padding-top:0] max-sm:[padding-bottom:60px] max-sm:[overflow:hidden] max-landscape:[max-width:none] max-landscape:[padding-top:40px] max-landscape:[padding-bottom:40px]">
        <div class="image-wrapper-blog [pointer-events:none] [justify-content:center] [align-items:flex-start] [display:flex] [position:absolute] [inset:0%_0%_auto]"><img data-meno-optimize="false" src="/images/bg.avif" loading="lazy" alt="A group of three giraffe standing next to each other" class="image-blog-gradient [pointer-events:none] [min-width:1400px] [position:absolute] [bottom:auto]" /></div>
        <div class="w-layout-blockcontainer container-1280 w-container [margin-left:auto] [margin-right:auto] [max-width:1360px] [display:block] [width:100%] [padding-left:40px] [padding-right:40px] [text-decoration:none] max-lg:[max-width:728px] max-lg:[margin-top:0] max-lg:[padding:40px] max-sm:[max-width:none] max-sm:[padding-top:40px] max-landscape:[max-width:none] max-landscape:[margin-top:0] max-landscape:[padding-top:64px] max-landscape:[padding-left:20px] max-landscape:[padding-right:20px]">
          <div class="cms-blog-button [grid-column-gap:20px] [grid-row-gap:20px] [flex-flow:column] [display:flex]">
            <div class="heading-button-blog [justify-content:space-between] [align-items:center] [display:flex] max-sm:[justify-content:space-between] max-sm:[align-items:flex-end]">
              <h3 class="h3 [color:#fff] [text-wrap:balance] [font-family:Switzer,_sans-serif] [font-size:24px] [font-weight:600] [line-height:120%] max-lg:[font-size:22px] max-sm:[font-size:18px]">Latest Study Case</h3>
              <div data-w-id="ed012faa-471e-0c82-8f73-fa6ed31ec01c" class="glowing-wrapper glowing-wrapper-active [border-radius:62.5rem] [display:inline-block] [position:relative] [overflow:hidden] max-sm:[width:fit-content]">
                <div class="button-css w-embed [display:none]">
                  <Embed html={__embed0} />
                </div>
                <div class="glowing-wrapper-borders-masker [opacity:0] [border-radius:62.5rem] [width:100%] [padding:.06rem] [line-height:100%] [transition:opacity_1s] [position:absolute] [top:0] [left:0]">
                  <div class="glowing-wrapper-borders [opacity:0] [width:100%] [position:absolute] [top:50%] [left:50%] [transform:translate(-50%,_-50%)]"></div>
                </div>
              </div>
            </div>
            <div class="w-dyn-list">
              <div role="list" class="collection-list w-dyn-items [grid-column-gap:40px] [grid-row-gap:40px] [grid-template-rows:auto] [grid-template-columns:1fr_1fr_1fr] [grid-auto-columns:1fr] [display:grid] max-lg:[grid-column-gap:20px] max-lg:[grid-row-gap:20px] max-lg:[flex-flow:wrap] max-lg:[grid-template-rows:auto] max-lg:[grid-template-columns:1fr_1fr] max-lg:[grid-auto-columns:1fr] max-lg:[display:grid] max-lg:[overflow:auto] max-landscape:[grid-template-columns:1fr] max-sm:[grid-column-gap:12px] max-sm:[grid-row-gap:12px] max-sm:[flex-flow:column]">
                <div role="listitem" class="card w-dyn-item [aspect-ratio:auto] [width:100%] [height:100%] [color:var(--white)] [cursor:pointer] [background-image:radial-gradient(circle_at_100%_-15%,_#140d24,_#0a0814_53%)] [border:1px_solid_#ffffff0d] [border-radius:16px] [flex-direction:column] [justify-content:center] [align-items:center] [padding:0] [text-decoration:none] [display:flex] [position:relative] max-lg:[border-radius:16px]">
                  <div class="card-contaiiner flex [flex:1] [color:] [flex-flow:column] [display:flex] max-lg:[grid-column-gap:0px] max-lg:[grid-row-gap:0px] max-lg:[border-radius:20px] max-lg:[flex-flow:column] max-lg:[order:1] max-lg:[display:flex]">
                    <a href="#" class="card wrapper w-inline-block [max-width:100%] [display:flex] [aspect-ratio:auto] [width:auto] [height:auto] [color:var(--white)] [cursor:pointer] [background-image:radial-gradient(circle_at_100%_-15%,_#140d24,_#0a0814_53%)] [border:1px_solid_#ffffff0d] [border-radius:16px] [flex-direction:column] [justify-content:center] [align-items:center] [padding:0] [text-decoration:none] [position:static] [flex:0_auto] max-lg:[border-radius:16px]">
                      <div class="card-content [z-index:1] [opacity:1] [justify-content:flex-start] [align-items:stretch] [position:relative] [background-image:radial-gradient(circle_at_100%_-15%,_#140d24,_#0a0814_53%)] [border:1px_solid_#ffffff0d] [border-radius:13px] [flex-flow:column] [align-self:stretch] [width:auto] [height:auto] [overflow:hidden] max-sm:[width:100%]"><img data-meno-optimize="false" src="https://d3e54v103j8qbb.cloudfront.net/plugins/Basic/assets/placeholder.60f9b1840c.svg" loading="eager" alt="" class="img-main-blog w-dyn-bind-empty [object-fit:cover] [border-radius:12px] [width:100%] [height:auto] max-lg:[width:100%]" /></div>
                    </a>
                    <div class="text-wrapper-card-blog [grid-column-gap:4px] [grid-row-gap:4px] [flex-flow:column] [align-items:flex-start] [height:100%] [padding:24px_24px_32px] [display:flex]">
                      <div class="gap-16-blog [z-index:111] [grid-column-gap:16px] [grid-row-gap:16px] [flex-flow:column] [align-items:flex-start] [display:flex] max-lg:[grid-column-gap:12px] max-lg:[grid-row-gap:12px] max-lg:[width:100%] max-landscape:[grid-column-gap:16px] max-landscape:[grid-row-gap:16px]">
                        <div class="w-dyn-list">
                          <div role="list" class="collection-list-5 w-dyn-items [grid-column-gap:12px] [grid-row-gap:12px] [grid-template-rows:auto] [grid-template-columns:1fr_1fr_1fr_1fr] [grid-auto-columns:1fr] [place-items:center_start] [display:flex]">
                            <div role="listitem" class="w-dyn-item">
